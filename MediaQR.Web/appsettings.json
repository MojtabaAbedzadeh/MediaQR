{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "GeoIp": {
    "Provider": "IpApi",
    "BaseUrl": "https://api.ipapi.is/",
    "TimeoutSeconds": 5,
    "CacheMinutes": 1440
  },

  "MediaUrlSecurity": {
    "LifetimeSeconds": 300
  },

  "AnalyticsPrivacy": {
    "RetentionDays": 365,
    "CleanupIntervalHours": 24
  },

  "FileValidation": {
    "MaxImageSize": 20971520,
    "MaxAudioSize": 104857600,
    "MaxVideoSize": 1073741824
  },

  "FileStorage": {
    "RootPath": "App_Data/Media"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
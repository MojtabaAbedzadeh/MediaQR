@model MediaQR.Application.DTOs.Dashboard.UserDashboardDto

@{
    ViewData["Title"] = "داشبورد من";
}

<div class="dashboard-page" dir="rtl">

    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="dashboard-header mb-4">
            <div>
                <h1 class="dashboard-title">
                    سلام، @Model.UserName 👋
                </h1>

                <p class="dashboard-subtitle">
                    به داشبورد شخصی خود خوش آمدید.
                </p>
            </div>

            <div class="dashboard-header-actions">
                <a asp-controller="AudioMessage"
                   asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-mic-fill"></i>
                    ایجاد پیام صوتی
                </a>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row g-4 mb-4">

            <!-- Media -->
            <div class="col-12 col-md-4">
                <div class="dashboard-stat-card">
                    <div class="stat-icon media-icon">
                        <i class="bi bi-file-earmark-music-fill"></i>
                    </div>

                    <div class="stat-content">
                        <span class="stat-label">
                            فایل‌های من
                        </span>

                        <strong class="stat-value">
                            @Model.MediaCount
                        </strong>
                    </div>
                </div>
            </div>

            <!-- QR -->
            <div class="col-12 col-md-4">
                <div class="dashboard-stat-card">
                    <div class="stat-icon qr-icon">
                        <i class="bi bi-qr-code"></i>
                    </div>

                    <div class="stat-content">
                        <span class="stat-label">
                            QR Codeهای من
                        </span>

                        <strong class="stat-value">
                            @Model.QrCodeCount
                        </strong>
                    </div>
                </div>
            </div>

            <!-- Plays -->
            <div class="col-12 col-md-4">
                <div class="dashboard-stat-card">
                    <div class="stat-icon play-icon">
                        <i class="bi bi-play-circle-fill"></i>
                    </div>

                    <div class="stat-content">
                        <span class="stat-label">
                            تعداد پخش
                        </span>

                        <strong class="stat-value">
                            @Model.PlayCount
                        </strong>
                    </div>
                </div>
            </div>

        </div>

        <!-- Account -->
        <div class="row g-4">

            <div class="col-12 col-lg-8">

                <div class="dashboard-card">

                    <div class="dashboard-card-header">

                        <div>
                            <h2>
                                آخرین QR Codeها
                            </h2>

                            <p>
                                آخرین QR Codeهای ایجاد شده توسط شما
                            </p>
                        </div>

                        <a asp-controller="MyQr"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">
                            مشاهده همه
                        </a>

                    </div>

                    @if (Model.RecentQrCodes.Any())
                    {
                        <div class="table-responsive">

                            <table class="table dashboard-table align-middle">

                                <thead>
                                    <tr>
                                        <th>
                                            عنوان
                                        </th>

                                        <th>
                                            فایل
                                        </th>

                                        <th>
                                            وضعیت
                                        </th>

                                        <th>
                                            تاریخ ایجاد
                                        </th>

                                        <th>
                                            عملیات
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var qr in Model.RecentQrCodes)
                                    {
                                        var expired =
                                        qr.IsExpired;

                                        var active =
                                        qr.IsActive && !expired;

                                        <tr>

                                            <td>
                                                <div class="qr-title">

                                                    <div class="qr-mini-icon">
                                                        <i class="bi bi-qr-code"></i>
                                                    </div>

                                                    <div>
                                                        <strong>
                                                            @(string.IsNullOrWhiteSpace(qr.Title)
                                                                                                                ? "بدون عنوان"
                                                                                                                : qr.Title)
                                                </strong>

                                                        <small>
                                                            @qr.Code
                                                        </small>
                                                    </div>

                                                </div>
                                            </td>

                                            <td>
                                                <span>
                                                    @qr.MediaTitle
                                                </span>

                                                <small class="d-block text-muted">
                                                    @qr.MediaType
                                                </small>
                                            </td>

                                            <td>

                                        @if (expired)
                                                {
                                                    <span class="status-badge status-expired">
                                                        منقضی شده
                                                    </span>
                                                }
                                                else if (active)
                                                {
                                                    <span class="status-badge status-active">
                                                        فعال
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-disabled">
                                                        غیرفعال
                                                    </span>
                                                }

                                            </td>

                                            <td>
                                                <span class="date-value">
                                                    @qr.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                                                </span>
                                            </td>

                                            <td>

                                                <a href="@qr.QrUrl"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="btn btn-sm btn-light"
                                                   title="مشاهده QR">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="empty-state">

                            <div class="empty-icon">
                                <i class="bi bi-qr-code"></i>
                            </div>

                            <h3>
                                هنوز QR Codeای ایجاد نکرده‌اید
                            </h3>

                            <p>
                                اولین پیام صوتی خود را ایجاد کنید
                                و QR Code اختصاصی آن را دریافت کنید.
                            </p>

                            <a asp-controller="AudioMessage"
                               asp-action="Create"
                               class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i>
                                ایجاد پیام صوتی
                            </a>

                        </div>
                    }

                </div>

            </div>

            <!-- Account information -->
            <div class="col-12 col-lg-4">

                <div class="dashboard-card account-card">

                    <div class="dashboard-card-header">

                        <div>
                            <h2>
                                اطلاعات حساب
                            </h2>

                            <p>
                                اطلاعات کاربری شما
                            </p>
                        </div>

                        <div class="account-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                    </div>

                    <div class="account-info">

                        <div class="account-info-item">

                            <span class="account-info-label">
                                نام کاربری
                            </span>

                            <strong>
                                @Model.UserName
                            </strong>

                        </div>

                        <div class="account-info-item">

                            <span class="account-info-label">
                                شماره همراه
                            </span>

                            <strong dir="ltr">
                                @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                                                ? "ثبت نشده"
                                                                : Model.PhoneNumber)
                            </strong>

                        </div>

                    </div>

                    <div class="account-actions">

                        <a asp-controller="Account"
                           asp-action="ChangePassword"
                           class="account-action">
                            <i class="bi bi-shield-lock"></i>
                            تغییر رمز عبور
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .dashboard-page {
        min-height: calc(100vh - 80px);
        background: #f7f8fc;
        color: #252336;
    }

    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .dashboard-title {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        color: #252336;
    }

    .dashboard-subtitle {
        margin: 8px 0 0;
        color: #77748a;
        font-size: 14px;
    }

    .dashboard-header-actions .btn {
        min-height: 44px;
        border-radius: 12px;
        padding: 0 18px;
        font-weight: 600;
    }

    .dashboard-stat-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px;
        background: #fff;
        border: 1px solid #ececf2;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(40, 35, 70, 0.05);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .dashboard-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(40, 35, 70, 0.09);
        }

    .stat-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .media-icon {
        background: #f0eafa;
        color: #6f42c1;
    }

    .qr-icon {
        background: #e8f0ff;
        color: #3768d5;
    }

    .play-icon {
        background: #e8f8ef;
        color: #22965b;
    }

    .stat-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stat-label {
        color: #77748a;
        font-size: 13px;
    }

    .stat-value {
        font-size: 28px;
        line-height: 1;
        font-weight: 800;
        color: #252336;
    }

    .dashboard-card {
        background: #fff;
        border: 1px solid #ececf2;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(40, 35, 70, 0.05);
        overflow: hidden;
    }

    .dashboard-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 24px;
        border-bottom: 1px solid #eeeeF3;
    }

        .dashboard-card-header h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
        }

        .dashboard-card-header p {
            margin: 5px 0 0;
            color: #858296;
            font-size: 12px;
        }

        .dashboard-card-header .btn {
            white-space: nowrap;
            border-radius: 9px;
        }

    .dashboard-table {
        margin: 0;
    }

        .dashboard-table thead th {
            background: #fafafe;
            color: #77748a;
            border-bottom: 1px solid #eeeeF3;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
            padding: 14px 20px;
        }

        .dashboard-table tbody td {
            padding: 15px 20px;
            border-bottom: 1px solid #f0f0f4;
            font-size: 13px;
            color: #464355;
        }

        .dashboard-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .qr-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 170px;
    }

    .qr-mini-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #f0eafa;
        color: #6f42c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .qr-title strong {
        display: block;
        font-size: 13px;
        color: #2d2a3b;
    }

    .qr-title small {
        display: block;
        margin-top: 3px;
        font-size: 10px;
        color: #9895a6;
        direction: ltr;
        text-align: right;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #e9f8ef;
        color: #218c57;
    }

    .status-disabled {
        background: #f1f1f4;
        color: #777582;
    }

    .status-expired {
        background: #fff0f0;
        color: #c34d4d;
    }

    .date-value {
        direction: ltr;
        display: inline-block;
        white-space: nowrap;
    }

    .account-card {
        height: 100%;
    }

    .account-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #f0eafa;
        color: #6f42c1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .account-info {
        padding: 8px 24px;
    }

    .account-info-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 15px 0;
        border-bottom: 1px solid #f0f0f4;
    }

        .account-info-item:last-child {
            border-bottom: 0;
        }

    .account-info-label {
        color: #888596;
        font-size: 11px;
    }

    .account-info-item strong {
        color: #343142;
        font-size: 14px;
    }

    .account-actions {
        padding: 16px 24px 22px;
    }

    .account-action {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #f7f5fc;
        color: #60409c;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: background .2s ease;
    }

        .account-action:hover {
            background: #eee9f8;
            color: #50358a;
        }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 16px;
        border-radius: 18px;
        background: #f3f0fa;
        color: #7251a7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 800;
    }

    .empty-state p {
        margin: 0 auto 20px;
        max-width: 430px;
        color: #858296;
        font-size: 13px;
        line-height: 1.8;
    }

    .empty-state .btn {
        border-radius: 10px;
    }

    @@media (max-width: 767.98px) {
        .dashboard-page .container-fluid {
            padding-left: 14px;
            padding-right: 14px;
        }

        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-header-actions {
            width: 100%;
        }

            .dashboard-header-actions .btn {
                width: 100%;
            }

        .dashboard-title {
            font-size: 23px;
        }

        .dashboard-card-header {
            padding: 18px;
        }

        .dashboard-table thead th,
        .dashboard-table tbody td {
            padding-left: 14px;
            padding-right: 14px;
        }

        .account-info {
            padding-left: 18px;
            padding-right: 18px;
        }

        .account-actions {
            padding-left: 18px;
            padding-right: 18px;
        }
    }
</style>
@model MediaQR.Application.DTOs.Media.CreateMediaResultDto

@{
    ViewData["Title"] = "رسانه با موفقیت ایجاد شد";

    var qrImageSrc =
        $"data:image/png;base64,{Model.QrImageBase64}";
}

<div class="media-success-page" dir="rtl">

    <!-- Background Decorations -->
    <div class="success-bg-shape success-bg-shape-1"></div>
    <div class="success-bg-shape success-bg-shape-2"></div>
    <div class="success-bg-shape success-bg-shape-3"></div>


    <div class="media-success-wrapper">

        <!-- Success Header -->
        <div class="success-header">

            <div class="success-icon">
                <span>✓</span>
            </div>

            <div class="success-badge">
                <span>♡</span>
                آماده است
            </div>

            <h1>
                رسانه با <span>موفقیت</span> ایجاد شد
            </h1>

            <p>
                QR Code اختصاصی رسانه شما ساخته شد.
                می‌توانید آن را ذخیره کرده یا لینک آن را با دیگران به اشتراک بگذارید.
            </p>

        </div>


        <!-- Main Card -->
        <div class="media-success-card">

            <!-- QR Section -->
            <div class="qr-section">

                <div class="qr-section-title">
                    <span class="qr-title-icon">▦</span>

                    <div>
                        <strong>QR Code شما آماده است</strong>

                        <small>
                            این کد را اسکن کنید تا رسانه نمایش داده شود.
                        </small>
                    </div>
                </div>


                <div class="qr-code-container">

                    <div class="qr-glow"></div>

                    <div class="qr-code-frame">

                        <img src="@qrImageSrc"
                             alt="QR Code رسانه @Model.Title"
                             class="qr-image" />

                    </div>

                </div>


                <!-- QR Code -->
                <div class="qr-code-label">

                    <span>
                        کد QR
                    </span>

                    <code>
                        @Model.QrCode
                    </code>

                </div>


                <!-- QR Actions -->
                <div class="qr-actions">

                    <a href="@qrImageSrc"
                       download="@($"mediaqr-{Model.QrCode}.png")"
                       class="qr-action qr-action-download">

                        <span class="action-icon">
                            ↓
                        </span>

                        <span>
                            دانلود QR
                        </span>

                    </a>


                    <button type="button"
                            class="qr-action qr-action-copy"
                            id="copyQrButton">

                        <span class="action-icon">
                            ⧉
                        </span>

                        <span>
                            کپی لینک
                        </span>

                    </button>


                    <a href="@Model.QrUrl"
                       target="_blank"
                       rel="noopener"
                       class="qr-action qr-action-view">

                        <span class="action-icon">
                            ↗
                        </span>

                        <span>
                            مشاهده رسانه
                        </span>

                    </a>

                </div>

            </div>


            <!-- Divider -->
            <div class="success-divider"></div>


            <!-- Media Information -->
            <div class="media-information">

                <div class="information-title">

                    <span class="information-title-icon">
                        ✦
                    </span>

                    اطلاعات رسانه

                </div>


                <div class="information-grid">

                    <!-- Title -->
                    <div class="information-item">

                        <div class="information-icon">
                            ♡
                        </div>

                        <div class="information-content">

                            <span class="information-label">
                                عنوان
                            </span>

                            <strong>
                                @Model.Title
                            </strong>

                        </div>

                    </div>


                    <!-- File -->
                    <div class="information-item">

                        <div class="information-icon">
                            ▧
                        </div>

                        <div class="information-content">

                            <span class="information-label">
                                نام فایل
                            </span>

                            <strong title="@Model.OriginalFileName">
                                @Model.OriginalFileName
                            </strong>

                        </div>

                    </div>


                    <!-- Media Type -->
                    <div class="information-item">

                        <div class="information-icon">
                            ▶
                        </div>

                        <div class="information-content">

                            <span class="information-label">
                                نوع رسانه
                            </span>

                            <strong>
                                @Model.MediaType
                            </strong>

                        </div>

                    </div>


                    <!-- QR Code -->
                    <div class="information-item">

                        <div class="information-icon">
                            #
                        </div>

                        <div class="information-content">

                            <span class="information-label">
                                کد QR
                            </span>

                            <strong class="qr-code-text">
                                @Model.QrCode
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- URL Section -->
            <div class="url-section">

                <div class="url-section-header">

                    <div class="url-section-icon">
                        🔗
                    </div>

                    <div>

                        <strong>
                            لینک رسانه
                        </strong>

                        <span>
                            این لینک را می‌توانید با دیگران به اشتراک بگذارید.
                        </span>

                    </div>

                </div>


                <div class="url-copy-box">

                    <input type="text"
                           id="qrUrl"
                           value="@Model.QrUrl"
                           readonly
                           aria-label="آدرس رسانه" />

                    <button type="button"
                            id="copyUrlButton">

                        <span id="copyUrlIcon">
                            ⧉
                        </span>

                        <span id="copyUrlText">
                            کپی
                        </span>

                    </button>

                </div>

            </div>


            <!-- Copy Success Message -->
            <div class="copy-success-message"
                 id="copySuccessMessage">

                <span>✓</span>

                لینک با موفقیت کپی شد.

            </div>


            <!-- Bottom Actions -->
            <div class="success-bottom-actions">

                <a href="@Model.QrUrl"
                   target="_blank"
                   rel="noopener"
                   class="success-primary-button">

                    <span>
                        مشاهده رسانه
                    </span>

                    <span>
                        ←
                    </span>

                </a>


                <a asp-controller="Media"
                   asp-action="Create"
                   class="success-secondary-button">

                    <span>
                        +
                    </span>

                    رسانه جدید

                </a>

            </div>

        </div>


        <!-- Footer -->
        <div class="success-footer">

            <span>
                <span class="footer-check">✓</span>
                رسانه شما آماده استفاده است
            </span>

            <span>
                <span class="footer-heart">♡</span>
                ساخته شده با عشق
            </span>

        </div>

    </div>

</div>


<style>

    /* =========================================
           Main Page
        ========================================== */

    .media-success-page {
        position: relative;
        min-height: calc(100vh - 70px);
        padding: 50px 20px 70px;
        overflow: hidden;
        background: radial-gradient( circle at 8% 12%, rgba(255, 184, 215, .25), transparent 28% ), radial-gradient( circle at 92% 18%, rgba(190, 178, 255, .25), transparent 30% ), linear-gradient( 145deg, #fff8fc 0%, #faf8ff 50%, #f5faff 100% );
    }


    /* =========================================
           Background Shapes
        ========================================== */

    .success-bg-shape {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
    }

    .success-bg-shape-1 {
        width: 350px;
        height: 350px;
        top: -130px;
        right: -110px;
        background: rgba(244, 171, 210, .16);
    }

    .success-bg-shape-2 {
        width: 300px;
        height: 300px;
        bottom: -120px;
        left: -100px;
        background: rgba(166, 155, 245, .15);
    }

    .success-bg-shape-3 {
        width: 100px;
        height: 100px;
        top: 48%;
        right: 5%;
        background: rgba(125, 194, 255, .10);
    }


    /* =========================================
           Wrapper
        ========================================== */

    .media-success-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
    }


    /* =========================================
           Header
        ========================================== */

    .success-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .success-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 23px;
        background: linear-gradient( 135deg, #71d7b2, #66bda7 );
        color: white;
        font-size: 30px;
        font-weight: 800;
        box-shadow: 0 15px 35px rgba(73, 173, 139, .22);
        transform: rotate(-3deg);
    }

        .success-icon span {
            transform: rotate(3deg);
        }

    .success-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        margin-bottom: 12px;
        border-radius: 30px;
        background: rgba(255, 255, 255, .75);
        border: 1px solid rgba(255, 255, 255, .9);
        color: #5d9e87;
        font-size: 12px;
        font-weight: 700;
        box-shadow: 0 6px 20px rgba(80, 100, 100, .06);
    }

        .success-badge span {
            color: #e275aa;
            font-size: 16px;
        }

    .success-header h1 {
        margin: 0;
        color: #352b43;
        font-size: clamp(27px, 4vw, 38px);
        font-weight: 800;
        letter-spacing: -1px;
    }

        .success-header h1 span {
            background: linear-gradient( 90deg, #62b994, #8d78dd );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .success-header p {
        max-width: 580px;
        margin: 12px auto 0;
        color: #887e91;
        font-size: 14px;
        line-height: 1.9;
    }


    /* =========================================
           Main Card
        ========================================== */

    .media-success-card {
        padding: 32px;
        border-radius: 30px;
        background: rgba(255, 255, 255, .78);
        border: 1px solid rgba(255, 255, 255, .92);
        box-shadow: 0 25px 70px rgba(70, 45, 95, .10), inset 0 1px 0 rgba(255, 255, 255, .9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }


    /* =========================================
           QR Section
        ========================================== */

    .qr-section {
        text-align: center;
    }

    .qr-section-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 11px;
        margin-bottom: 24px;
    }

    .qr-title-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient( 135deg, #f8d7e8, #e2dbfa );
        color: #9a76ae;
        font-size: 22px;
    }

    .qr-section-title div {
        text-align: right;
    }

    .qr-section-title strong {
        display: block;
        color: #51445c;
        font-size: 14px;
    }

    .qr-section-title small {
        display: block;
        margin-top: 3px;
        color: #a79daa;
        font-size: 11px;
    }


    /* =========================================
           QR Image
        ========================================== */

    .qr-code-container {
        position: relative;
        width: 290px;
        height: 290px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qr-glow {
        position: absolute;
        inset: 15px;
        border-radius: 45px;
        background: linear-gradient( 135deg, rgba(242, 167, 207, .22), rgba(161, 144, 238, .20) );
        filter: blur(20px);
    }

    .qr-code-frame {
        position: relative;
        width: 255px;
        height: 255px;
        padding: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 25px;
        background: white;
        box-shadow: 0 18px 45px rgba(70, 45, 90, .13);
        border: 1px solid #eee7f0;
    }

    .qr-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        border-radius: 10px;
    }


    /* =========================================
           QR Label
        ========================================== */

    .qr-code-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 8px 12px;
        border-radius: 12px;
        background: #f8f4fa;
        color: #9b91a3;
        font-size: 11px;
    }

        .qr-code-label code {
            direction: ltr;
            color: #765f82;
            font-size: 12px;
            font-weight: 700;
            background: transparent;
        }


    /* =========================================
           QR Actions
        ========================================== */

    .qr-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .qr-action {
        min-width: 135px;
        height: 44px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 13px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .qr-action:hover {
            transform: translateY(-2px);
        }

    .action-icon {
        font-size: 17px;
    }

    .qr-action-download {
        color: #a15f91;
        background: #fff0f7;
        border: 1px solid #f2d8e7;
    }

    .qr-action-copy {
        color: #7564a2;
        background: #f3f0ff;
        border: 1px solid #e3ddf7;
    }

    .qr-action-view {
        color: #4f9c80;
        background: #edf9f4;
        border: 1px solid #d6eee3;
    }


    /* =========================================
           Divider
        ========================================== */

    .success-divider {
        height: 1px;
        margin: 32px 0;
        background: linear-gradient( 90deg, transparent, #eee5ef, transparent );
    }


    /* =========================================
           Information
        ========================================== */

    .information-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 17px;
        color: #55485f;
        font-size: 14px;
        font-weight: 800;
    }

    .information-title-icon {
        color: #d36ca0;
        font-size: 18px;
    }

    .information-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .information-item {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        padding: 14px;
        border-radius: 16px;
        background: rgba(250, 247, 251, .85);
        border: 1px solid #eee8f0;
    }

    .information-icon {
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: white;
        color: #b17da5;
        font-size: 17px;
        box-shadow: 0 5px 15px rgba(80, 60, 90, .06);
    }

    .information-content {
        min-width: 0;
    }

    .information-label {
        display: block;
        margin-bottom: 4px;
        color: #aaa0ad;
        font-size: 10px;
    }

    .information-content strong {
        display: block;
        overflow: hidden;
        color: #51445b;
        font-size: 12px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .qr-code-text {
        direction: ltr;
        text-align: right;
    }


    /* =========================================
           URL Section
        ========================================== */

    .url-section {
        margin-top: 24px;
        padding: 18px;
        border-radius: 19px;
        background: linear-gradient( 135deg, rgba(255, 244, 250, .85), rgba(244, 241, 255, .85) );
        border: 1px solid #eee5f0;
    }

    .url-section-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .url-section-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: white;
        font-size: 16px;
        box-shadow: 0 5px 15px rgba(80, 60, 90, .06);
    }

    .url-section-header strong {
        display: block;
        color: #5a4c63;
        font-size: 12px;
    }

    .url-section-header span {
        display: block;
        margin-top: 3px;
        color: #aaa0ad;
        font-size: 10px;
    }

    .url-copy-box {
        display: flex;
        align-items: stretch;
        gap: 7px;
        direction: ltr;
    }

        .url-copy-box input {
            flex: 1;
            min-width: 0;
            height: 46px;
            padding: 0 13px;
            border: 1px solid #e5dce8;
            border-radius: 12px;
            outline: none;
            background: rgba(255, 255, 255, .85);
            color: #776a7f;
            font-family: Arial, sans-serif;
            font-size: 11px;
            direction: ltr;
            text-align: left;
        }

            .url-copy-box input:focus {
                border-color: #d69cbd;
                box-shadow: 0 0 0 3px rgba(214, 156, 189, .10);
            }

        .url-copy-box button {
            flex: 0 0 auto;
            min-width: 75px;
            height: 46px;
            border: 0;
            border-radius: 12px;
            background: linear-gradient( 135deg, #e27bac, #a17ddd );
            color: white;
            font-family: inherit;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s ease;
        }

            .url-copy-box button:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(170, 100, 170, .18);
            }


    /* =========================================
           Copy Success
        ========================================== */

    .copy-success-message {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 10px;
        padding: 9px;
        border-radius: 11px;
        background: #edf9f4;
        border: 1px solid #d5eee3;
        color: #4c9b7d;
        font-size: 11px;
        font-weight: 700;
    }

        .copy-success-message.show {
            display: flex;
        }


    /* =========================================
           Bottom Actions
        ========================================== */

    .success-bottom-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 25px;
    }

    .success-primary-button,
    .success-secondary-button {
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 15px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: all .2s ease;
    }

    .success-primary-button {
        background: linear-gradient( 100deg, #e879ac, #a47ee1 );
        color: white;
        box-shadow: 0 12px 28px rgba(181, 105, 171, .20);
    }

        .success-primary-button:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(181, 105, 171, .26);
        }

    .success-secondary-button {
        background: white;
        color: #7a6b82;
        border: 1px solid #e5dce8;
    }

        .success-secondary-button:hover {
            color: #6c5d74;
            background: #fcf9fd;
            transform: translateY(-2px);
        }


    /* =========================================
           Footer
        ========================================== */

    .success-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-top: 20px;
        color: #a49aa9;
        font-size: 10px;
    }

        .success-footer > span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

    .footer-check {
        width: 16px;
        height: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e5f7ef;
        color: #5cab8b;
        font-size: 9px;
    }

    .footer-heart {
        color: #df78a9;
        font-size: 15px;
    }


    /* =========================================
           Responsive
        ========================================== */

    @@media (max-width: 700px) {

        .media-success-page {
            padding: 35px 14px 55px;
        }

        .media-success-card {
            padding: 24px 18px;
            border-radius: 24px;
        }

        .success-header {
            margin-bottom: 22px;
        }

        .success-icon {
            width: 62px;
            height: 62px;
            border-radius: 20px;
        }

        .success-header h1 {
            font-size: 28px;
        }

        .success-header p {
            font-size: 12px;
        }

        .qr-code-container {
            width: 260px;
            height: 260px;
        }

        .qr-code-frame {
            width: 225px;
            height: 225px;
        }

        .information-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 480px) {

        .media-success-page {
            padding: 25px 10px 45px;
        }

        .media-success-card {
            padding: 20px 14px;
            border-radius: 21px;
        }

        .success-header h1 {
            font-size: 25px;
        }

        .qr-section-title {
            justify-content: flex-start;
        }

            .qr-section-title div {
                text-align: right;
            }

        .qr-code-container {
            width: 235px;
            height: 235px;
        }

        .qr-code-frame {
            width: 205px;
            height: 205px;
            padding: 10px;
        }

        .qr-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .qr-action {
            min-width: 0;
        }

        .qr-action-view {
            grid-column: 1 / -1;
        }

        .url-copy-box {
            flex-direction: column;
        }

            .url-copy-box input {
                width: 100%;
            }

            .url-copy-box button {
                width: 100%;
            }

        .success-bottom-actions {
            grid-template-columns: 1fr;
        }

        .success-footer {
            gap: 10px;
        }
    }

</style>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const qrUrlInput =
                document.getElementById("qrUrl");

            const copyUrlButton =
                document.getElementById("copyUrlButton");

            const copyUrlText =
                document.getElementById("copyUrlText");

            const copyUrlIcon =
                document.getElementById("copyUrlIcon");

            const copySuccessMessage =
                document.getElementById("copySuccessMessage");

            const copyQrButton =
                document.getElementById("copyQrButton");


            /* =================================
               Copy URL
            ================================= */

            async function copyQrUrl() {

                if (!qrUrlInput)
                    return;

                const value =
                    qrUrlInput.value;

                try {

                    if (
                        navigator.clipboard &&
                        window.isSecureContext
                    ) {

                        await navigator.clipboard.writeText(value);

                    }
                    else {

                        qrUrlInput.focus();
                        qrUrlInput.select();

                        document.execCommand("copy");

                    }

                    showCopySuccess();

                }
                catch (error) {

                    console.error(
                        "Copy failed:",
                        error
                    );

                    qrUrlInput.focus();
                    qrUrlInput.select();

                }

            }


            /* =================================
               Success State
            ================================= */

            function showCopySuccess() {

                if (copySuccessMessage) {

                    copySuccessMessage.classList.add("show");

                    setTimeout(function () {

                        copySuccessMessage.classList.remove("show");

                    }, 2500);

                }

                if (copyUrlText) {
                    copyUrlText.textContent = "کپی شد";
                }

                if (copyUrlIcon) {
                    copyUrlIcon.textContent = "✓";
                }

                if (copyUrlButton) {

                    setTimeout(function () {

                        copyUrlText.textContent = "کپی";
                        copyUrlIcon.textContent = "⧉";

                    }, 2500);

                }

            }


            /* =================================
               Main Copy Button
            ================================= */

            if (copyUrlButton) {

                copyUrlButton.addEventListener(
                    "click",
                    copyQrUrl
                );

            }


            /* =================================
               QR Action Copy
            ================================= */

            if (copyQrButton) {

                copyQrButton.addEventListener(
                    "click",
                    copyQrUrl
                );

            }

        });

    </script>

}
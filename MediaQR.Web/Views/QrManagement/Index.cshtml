@model IReadOnlyList<MediaQR.Application.DTOs.Qr.QrCodeListItemDto>

@{
    ViewData["Title"] = "مدیریت QR Code";
}

<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">مدیریت QR Code</h1>
            <p class="text-muted mb-0">
                مدیریت QR Codeهای ایجاد شده برای رسانه‌ها
            </p>
        </div>

        <div>
            <span class="badge bg-secondary fs-6">
                تعداد: @Model.Count
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="بستن">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <span style="font-size: 48px;">
                        ▦
                    </span>
                </div>

                <h2 class="h5">
                    هنوز QR Codeای ایجاد نشده است.
                </h2>

                <p class="text-muted mb-0">
                    پس از ایجاد رسانه، QR Code مربوط به آن در این قسمت نمایش داده می‌شود.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="text-center">
                                    #
                                </th>

                                <th>
                                    عنوان QR
                                </th>

                                <th>
                                    رسانه
                                </th>

                                <th>
                                    نوع
                                </th>

                                <th class="text-center">
                                    وضعیت
                                </th>

                                <th>
                                    تاریخ ایجاد
                                </th>

                                <th>
                                    انقضا
                                </th>

                                <th class="text-center">
                                    عملیات
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                var statusClass = "bg-success";
                                var statusText = "فعال";

                                if (!item.IsActive)
                                {
                                    statusClass = "bg-danger";
                                    statusText = "غیرفعال";
                                }
                                else if (item.IsExpired)
                                {
                                    statusClass = "bg-warning text-dark";
                                    statusText = "منقضی‌شده";
                                }

                            <tr>

                                <td class="text-center">
                                    @item.Id
                                </td>

                                <td>

                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(item.Title)
                                                                            ? "بدون عنوان"
                                                                            : item.Title)
                                </div>

                                        <small class="text-muted">
                                            @item.Code
                                        </small>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @item.MediaTitle
                                        </div>

                                        <small class="text-muted">
                                            @item.OriginalFileName
                                        </small>

                                    </td>

                                    <td>

                                @switch (item.MediaType)
                                        {
                                            case "Image":
                                                <span class="badge bg-info text-dark">
                                                    تصویر
                                                </span>
                                                break;

                                            case "Audio":
                                                <span class="badge bg-primary">
                                                    صوت
                                                </span>
                                                break;

                                            case "Video":
                                                <span class="badge bg-dark">
                                                    ویدئو
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @item.MediaType
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td class="text-center">

                                        <span class="badge @statusClass">
                                            @statusText
                                        </span>

                                    </td>

                                    <td>

                                        @item.CreatedAt.ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")

                                    </td>

                                    <td>

                                        @if (item.ExpiresAt.HasValue)
                                        {
                                            <span>
                                                @item.ExpiresAt.Value
                                                .ToLocalTime()
                                                .ToString("yyyy/MM/dd HH:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                بدون انقضا
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            مشاهده

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            ویرایش

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>
    .details-container {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 18px 16px 45px;
    }

    .my-media-details-page h1,
    .my-media-details-page h2,
    .my-media-details-page h3,
    .my-media-details-page p {
        font-family: inherit;
    }

    .my-media-details-page a {
        text-decoration: none;
    }

    /* =========================================
               BREADCRUMB
            ========================================= */

    .details-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 22px;
        color: var(--detail-muted);
        font-size: 13px;
    }

        .details-breadcrumb a {
            color: #9b7fa2;
            transition: color .2s ease;
        }

            .details-breadcrumb a:hover {
                color: var(--detail-pink-dark);
            }

    .breadcrumb-separator {
        color: #c4b5c9;
        font-size: 20px;
        line-height: 1;
    }

    .breadcrumb-current {
        color: var(--detail-text);
        font-weight: 700;
    }

    /* =========================================
               HERO
            ========================================= */

    .details-hero {
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: center;

            border-radius: 12px;
        }

        .media-preview-video video {
            width: 100%;
            max-height: 440px;
            border-radius: 12px;
            background: #17131a;
        }

    .preview-unavailable {
        min-height: 240px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-align: center;
        color: var(--detail-muted);
    }

        .preview-unavailable strong {
            color: var(--detail-text);
        }

        .preview-unavailable p {
            margin: 0;
            font-size: 12px;
        }

    .unavailable-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #bc7092;
        background: #fff0f6;
        font-size: 24px;
    }

    /* =========================================
               FILE INFORMATION
            ========================================= */

    .information-list {
        padding: 7px 23px 12px;
    }

    .information-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        min-height: 54px;
        padding: 11px 0;
        border-bottom: 1px solid #f4eef5;
    }

        .information-row:last-child {
            border-bottom: 0;
        }

    .information-label {
        display: flex;
        align-items: center;
        gap: 9px;
        flex: 0 0 auto;
        color: #8f8197;
        font-size: 12px;
    }

    .information-symbol {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #9877b4;
        background: #f8f2fa;
        font-size: 12px;
    }

    .information-value {
        min-width: 0;
        color: #514357;
        font-size: 12px;
        font-weight: 700;
        text-align: left;
        overflow-wrap: anywhere;
    }

    .information-break {
        max-width: 58%;
        direction: ltr;
    }

    .information-ltr {
        direction: ltr;
        unicode-bidi: plaintext;
    }

    /* =========================================
               DESCRIPTION
            ========================================= */

    .description-panel {
        margin-top: 22px;
    }

    .description-content {
        padding: 21px 24px 24px;
        color: #6f6277;
        font-size: 13px;
        line-height: 2.2;
        overflow-wrap: anywhere;
        white-space: pre-line;
    }

    /* =========================================
               ANALYTICS
            ========================================= */

    .analytics-section {
        margin-top: 32px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 18px;
    }

    .section-heading-main {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .section-icon {
        color: #fff;
        background: linear-gradient(135deg, #ff70aa, #a16df0);
        box-shadow: 0 7px 17px rgba(181, 94, 170, .16);
    }

    .analytics-period {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid #ece3f0;
        border-radius: 25px;
        color: #897991;
        background: #fff;
        font-size: 11px;
    }

    .analytics-period-dot {
        background: #43b58b;
    }

    .analytics-primary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
    }

    .analytics-card {
        position: relative;
        min-width: 0;
        min-height: 150px;
        padding: 18px;
        overflow: hidden;
        border: 1px solid #eee7f0;
        border-radius: 19px;
        background: #fff;
        box-shadow: 0 5px 18px rgba(90, 60, 110, .045);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .analytics-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(90, 60, 110, .09);
        }

        .analytics-card::after {
            content: "";
            position: absolute;
            left: -22px;
            bottom: -36px;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            opacity: .55;
            pointer-events: none;
        }

    .analytics-card-pink::after {
        background: #ffe3ef;
    }

    .analytics-card-purple::after {
        background: #eae0ff;
    }

    .analytics-card-blue::after {
        background: #e0f2ff;
    }

    .analytics-card-yellow::after {
        background: #fff1c8;
    }

    .analytics-card-green::after {
        background: #dff7eb;
    }

    .analytics-card-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .analytics-card-label {
        color: #8d8094;
        font-size: 11px;
        font-weight: 600;
    }

    .analytics-card-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 17px;
    }

    .analytics-card-pink .analytics-card-icon {
        color: #dc4c8c;
        background: #fff0f6;
    }

    .analytics-card-purple .analytics-card-icon {
        color: #8860d5;
        background: #f3edff;
    }

    .analytics-card-blue .analytics-card-icon {
        color: #418ec7;
        background: #edf7ff;

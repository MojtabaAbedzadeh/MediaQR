    }

    .hero-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
    }

    .delete-form {
        display: inline-flex;
        margin: 0;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 9px 14px;
        border: 1px solid transparent;
        border-radius: 13px;
        font: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        white-space: nowrap;
    }

        .action-button:hover {
            transform: translateY(-2px);
        }

    .action-icon {
        font-size: 17px;
        line-height: 1;
    }

    .action-edit {
        color: #fff;
        background: linear-gradient(135deg, #f86ca8, #a16cf0);
        box-shadow: 0 7px 17px rgba(182, 99, 177, .17);
    }

        .action-edit:hover {
            color: #fff;
            box-shadow: 0 10px 22px rgba(182, 99, 177, .25);
        }

    .action-back {
        color: #6e5a7c;
        border-color: #e9dff0;
        background: #fff;
    }

        .action-back:hover {
            color: var(--detail-purple);
            background: #faf7ff;
        }

    .action-delete {
        color: #c94e70;
        border-color: #f4d8e0;
        background: #fff7f9;
    }

        .action-delete:hover {
            color: #fff;
            border-color: #e85d83;
            background: #e85d83;
        }

    /* =========================================
               PANELS AND HEADINGS
            ========================================= */

    .top-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
        gap: 22px;
        align-items: stretch;
    }

    .panel {
        min-width: 0;
        border: 1px solid rgba(237, 227, 240, .9);
        border-radius: 22px;
        background: var(--detail-surface);
        box-shadow: var(--detail-shadow);
        overflow: hidden;
    }

    .panel-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 22px 23px;
        border-bottom: 1px solid #f5eff6;
    }

        .panel-heading h2,
        .section-heading h2 {
            margin: 0;
            color: #4b3a53;
            font-size: 16px;
            font-weight: 800;
            line-height: 1.7;
        }

        .panel-heading p,
        .section-heading p {
            margin: 3px 0 0;
            color: var(--detail-muted);
            font-size: 11px;
            line-height: 1.8;
        }

    .panel-heading-icon,
    .section-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 21px;
    }

    .preview-heading-icon {
        color: #d74d91;
        background: #fff0f7;
    }

    .information-heading-icon {
        color: #8161d1;
        background: #f3edff;
    }

    .description-heading-icon {
        color: #388fbc;
        background: #edf8ff;
    }

    .qr-heading-icon {
        color: #8b64dc;
        background: #f4efff;
    }

    .events-heading-icon {
        color: #b48725;
        background: #fff7e3;
    }

    /* =========================================
               PREVIEW
            ========================================= */

    .preview-body {
        padding: 23px;
    }

    .audio-player-container {
        padding: 25px 22px 19px;
        border: 1px solid #f3e2f0;
        border-radius: 22px;
        background: linear-gradient(145deg, #fff3f9, #f6f1ff);
        box-shadow: inset 0 1px 0 #fff;
        direction: ltr;
    }

    .sound-visualizer {
        height: 66px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        margin-bottom: 15px;
    }

        .sound-visualizer span {
            display: block;
            width: 5px;
            height: 20px;
            border-radius: 10px;
            background: linear-gradient(to top, #ff6baa, #a879ff);
            opacity: .55;
        }

        .sound-visualizer.active span {
            animation: detailSoundWave .8s infinite ease-in-out;
        }

        .sound-visualizer span:nth-child(2),
        .sound-visualizer span:nth-child(8) {
            animation-delay: .1s;
        }

        .sound-visualizer span:nth-child(3),
        .sound-visualizer span:nth-child(7) {
            animation-delay: .2s;
        }

        .sound-visualizer span:nth-child(4),
        .sound-visualizer span:nth-child(6) {
            animation-delay: .3s;
        }

        .sound-visualizer span:nth-child(5) {
            animation-delay: .4s;
        }

    @@keyframes detailSoundWave {
        0%, 100% {
            height: 18px;
        }

        50% {
            height: 55px;
        }
    }

    .audio-player-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 22px;
        text-align: right;
        direction: rtl;
    }

    .audio-note {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: #fff;
        background: linear-gradient(135deg, #ff70ac, #9f70ff);
        font-size: 22px;
        box-shadow: 0 6px 16px rgba(181, 94, 170, .16);
    }

    .audio-text {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

        .audio-text strong {
            color: #554658;
            font-size: 14px;
            overflow-wrap: anywhere;
        }

        .audio-text span {
            color: #9a8e9e;
            font-size: 11px;
            line-height: 1.8;
        }

    .audio-player {
        display: none;
    }

    .custom-audio-controls {
        display: flex;
        align-items: center;
        gap: 13px;
        direction: ltr;
    }

    .audio-play-button {
        width: 53px;
        height: 53px;
        flex: 0 0 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 50%;
        color: white;
        background: linear-gradient(135deg, #ff63a6, #a36aff);
        box-shadow: 0 8px 20px rgba(181, 94, 170, .28);
        cursor: pointer;
        font: inherit;
        font-size: 18px;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .audio-play-button:hover {
            transform: scale(1.06);
            box-shadow: 0 11px 25px rgba(181, 94, 170, .35);
        }

        .audio-play-button:disabled {
            cursor: not-allowed;
            opacity: .5;
            transform: none;
        }

    .audio-timeline {
        flex: 1;
        min-width: 0;
    }

    .audio-times {
        display: flex;
        justify-content: space-between;
        direction: ltr;
        color: #968a9b;
        font-size: 10px;
        margin-bottom: 9px;
        font-variant-numeric: tabular-nums;
    }

    .progress-track {
        position: relative;
        height: 7px;
        border-radius: 20px;
        background: #e9dfea;
        cursor: pointer;
        direction: ltr;
        outline-offset: 5px;
    }

        .progress-track:focus-visible {
            outline: 2px solid #9e6aff;
        }

    .progress-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: linear-gradient(90deg, #ff67a9, #9e6aff);
    }

    .progress-thumb {
        position: absolute;
        top: 50%;
        left: 0;
        width: 14px;
        height: 14px;
        transform: translate(-50%, -50%);
        border: 3px solid #a56bff;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 3px 8px rgba(120, 80, 150, .2);
    }

    .volume-button {
        width: 39px;
        height: 39px;
        flex: 0 0 39px;
        border: 1px solid #f0e5f0;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        transition: background .2s ease;
    }

        .volume-button:hover {
            background: #fff0f7;
        }

    .audio-player-message {
        min-height: 17px;
        margin-top: 10px;
        color: #9a8e9e;
        font-size: 11px;
        text-align: center;
    }

        .audio-player-message.error {
            color: #c34268;
        }

    .preview-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 17px;

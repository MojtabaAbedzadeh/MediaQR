        font-weight: 700;
    }

    .eyebrow-dot,
    .analytics-period-dot {
        width: 7px;
        height: 7px;
        flex: 0 0 7px;
        border-radius: 50%;
        background: var(--detail-pink);
    }

    .hero-title-content h1 {
        margin: 0 0 5px;
        color: #49344f;
        font-size: clamp(20px, 2.5vw, 27px);

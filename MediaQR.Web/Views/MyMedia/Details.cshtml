</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =========================================
           COPY QR URL
        ========================================= */

        async function copyText(text) {
            if (!text) {
                alert("لینکی برای کپی وجود ندارد.");
                return;
            }

            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                } else {
                    const textArea = document.createElement("textarea");
                    textArea.value = text;
                    textArea.setAttribute("readonly", "");
                    textArea.style.position = "fixed";
                    textArea.style.opacity = "0";
                    textArea.style.pointerEvents = "none";

                    document.body.appendChild(textArea);
                    textArea.select();

                    const copied = document.execCommand("copy");
                    textArea.remove();

                    if (!copied) {
                        throw new Error("Clipboard copy failed.");
                    }
                }

                alert("لینک با موفقیت کپی شد.");
            } catch (error) {
                console.error("Copy URL failed.", error);
                alert("کپی لینک انجام نشد. لطفاً لینک را به‌صورت دستی کپی کنید.");
            }
        }

        document.querySelectorAll("[data-copy-url]").forEach(function (button) {
            button.addEventListener("click", function () {
                copyText(button.dataset.copyUrl);
            });
        });

        /* =========================================
           PERSIAN DATE FORMATTING
        ========================================= */

        document.querySelectorAll(".persian-date[data-date]").forEach(function (element) {
            const rawDate = element.dataset.date;

            if (!rawDate) {
                return;
            }

            const date = new Date(rawDate);

            if (Number.isNaN(date.getTime())) {
                return;
            }

            try {
                const formatted = new Intl.DateTimeFormat("fa-IR-u-ca-persian", {
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                    hour: "2-digit",
                    minute: "2-digit",
                    hourCycle: "h23"
                }).format(date);

                element.textContent = formatted;
            } catch (error) {
                console.warn("Persian date formatting unavailable.", error);
            }
        });

        /* =========================================
           AUDIO PLAYER
        ========================================= */

        const audio = document.getElementById("mediaPlayer");

        if (!audio) {
            return;
        }

        const playButton = document.getElementById("audioPlayButton");
        const playIcon = document.getElementById("playIcon");
        const currentTime = document.getElementById("currentTime");
        const duration = document.getElementById("duration");
        const progressTrack = document.getElementById("progressTrack");
        const progressFill = document.getElementById("progressFill");
        const progressThumb = document.getElementById("progressThumb");
        const volumeButton = document.getElementById("volumeButton");
        const visualizer = document.getElementById("soundVisualizer");
        const message = document.getElementById("audioPlayerMessage");

        if (!playButton ||
            !playIcon ||
            !currentTime ||
            !duration ||
            !progressTrack ||
            !progressFill ||
            !progressThumb) {
            return;
        }

        function formatTime(seconds) {
            if (!Number.isFinite(seconds) || seconds < 0) {
                return "00:00";
            }

            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = Math.floor(seconds % 60);

            if (hours > 0) {
                return String(hours).padStart(2, "0") + ":" +
                    String(minutes).padStart(2, "0") + ":" +
                    String(secs).padStart(2, "0");
            }

            return String(minutes).padStart(2, "0") + ":" +
                String(secs).padStart(2, "0");
        }

        function showMessage(text, isError) {
            if (!message) {
                return;
            }

            message.textContent = text || "";
            message.classList.toggle("error", Boolean(isError));
        }

        function updateProgress() {
            if (!Number.isFinite(audio.duration) || audio.duration <= 0) {
                progressFill.style.width = "0%";
                progressThumb.style.left = "0%";
                progressTrack.setAttribute("aria-valuenow", "0");
                currentTime.textContent = formatTime(audio.currentTime);
                return;
            }

            const percent = Math.max(
                0,
                Math.min(100, (audio.currentTime / audio.duration) * 100)
            );

            progressFill.style.width = percent + "%";
            progressThumb.style.left = percent + "%";
            progressTrack.setAttribute("aria-valuenow", String(Math.round(percent)));
            currentTime.textContent = formatTime(audio.currentTime);
        }

        function updatePlayState(isPlaying) {
            playIcon.textContent = isPlaying ? "Ⅱ" : "▶";
            playButton.classList.toggle("playing", isPlaying);
            playButton.setAttribute("aria-label", isPlaying ? "توقف موقت" : "پخش");
            playButton.setAttribute("aria-pressed", String(isPlaying));

            if (visualizer) {
                visualizer.classList.toggle("active", isPlaying);
            }
        }

        playButton.addEventListener("click", async function () {
            showMessage("", false);

            try {
                if (audio.paused) {
                    await audio.play();
                } else {
                    audio.pause();
                }
            } catch (error) {
                console.error("Audio playback failed.", error);
                showMessage("پخش فایل انجام نشد. لطفاً اتصال و دسترسی فایل را بررسی کنید.", true);
            }
        });

        audio.addEventListener("play", function () {
            updatePlayState(true);
            showMessage("", false);
        });

        audio.addEventListener("pause", function () {
            updatePlayState(false);
        });

        audio.addEventListener("loadedmetadata", function () {
            duration.textContent = formatTime(audio.duration);
            updateProgress();
        });

        audio.addEventListener("durationchange", function () {
            duration.textContent = formatTime(audio.duration);
        });

        audio.addEventListener("timeupdate", updateProgress);

        audio.addEventListener("ended", function () {
            updatePlayState(false);
            currentTime.textContent = formatTime(audio.duration);
            progressFill.style.width = "100%";
            progressThumb.style.left = "100%";
            progressTrack.setAttribute("aria-valuenow", "100");
        });

        audio.addEventListener("error", function () {
            updatePlayState(false);
            showMessage("بارگذاری فایل صوتی با خطا مواجه شد.", true);
        });

        audio.addEventListener("waiting", function () {
            showMessage("در حال بارگذاری صوت...", false);
        });

        audio.addEventListener("canplay", function () {
            showMessage("", false);
        });

        function seekToPosition(clientX) {
            if (!Number.isFinite(audio.duration) || audio.duration <= 0) {
                return;
            }

            const rect = progressTrack.getBoundingClientRect();

            if (rect.width <= 0) {
                return;
            }

            const position = Math.max(
                0,
                Math.min(1, (clientX - rect.left) / rect.width)
            );

            audio.currentTime = position * audio.duration;
            updateProgress();
        }

        progressTrack.addEventListener("click", function (event) {
            seekToPosition(event.clientX);
        });

        progressTrack.addEventListener("keydown", function (event) {
            if (!Number.isFinite(audio.duration) || audio.duration <= 0) {
                return;
            }

            const step = Math.min(10, audio.duration * .05);

            if (event.key === "ArrowRight") {
                event.preventDefault();
                audio.currentTime = Math.min(audio.duration, audio.currentTime + step);
            } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                audio.currentTime = Math.max(0, audio.currentTime - step);
            } else if (event.key === "Home") {
                event.preventDefault();
                audio.currentTime = 0;
            } else if (event.key === "End") {
                event.preventDefault();
                audio.currentTime = audio.duration;
            }

            updateProgress();
        });

        if (volumeButton) {
            volumeButton.addEventListener("click", function () {
                audio.muted = !audio.muted;

                volumeButton.textContent = audio.muted ? "🔇" : "🔊";
                volumeButton.setAttribute(
                    "aria-label",
                    audio.muted ? "فعال کردن صدا" : "قطع صدا"
                );
                volumeButton.setAttribute("aria-pressed", String(audio.muted));
            });
        }

        updatePlayState(false);
        updateProgress();
    });
</script>
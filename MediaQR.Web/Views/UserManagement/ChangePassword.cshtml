@model MediaQR.Web.Models.Users.ChangeUserPasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
}
<style>
    .password-page {
        min-height: calc(100vh - 110px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px 20px;
        position: relative;
        overflow: hidden;
    }


    /* =========================================
           CONTAINER
        ========================================= */

    .password-container {
        width: 100%;
        max-width: 570px;
        position: relative;
        z-index: 2;
    }


    /* =========================================
           DECORATIONS
        ========================================= */

    .password-decoration {
        position: fixed;
        border-radius: 50%;
        filter: blur(2px);
        opacity: .5;
        pointer-events: none;
    }


    .decoration-one {
        width: 230px;
        height: 230px;
        top: 120px;
        right: -100px;
        background: linear-gradient( 135deg, #ffd6e9, #eadcff );
    }


    .decoration-two {
        width: 200px;
        height: 200px;
        bottom: 30px;
        left: -90px;
        background: linear-gradient( 135deg, #e0e0ff, #ffdbea );
    }


    /* =========================================
           CARD
        ========================================= */

    .password-card {
        position: relative;
        padding: 32px;
        border-radius: 30px;
        background: rgba(255, 255, 255, .91);
        border: 1px solid rgba(255, 255, 255, .95);
        box-shadow: 0 25px 70px rgba(130, 78, 140, .13);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }


    /* =========================================
           HEADER
        ========================================= */

    .password-header {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 25px;
    }


    .password-icon {
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 21px;
        font-size: 28px;
        background: linear-gradient( 135deg, #ffe0ef, #e9dcff );
        box-shadow: 0 10px 25px rgba(190, 100, 160, .13);
    }


    .password-title h1 {
        margin: 0 0 5px;
        color: #503952;
        font-size: 23px;
        font-weight: 800;
    }


    .password-title p {
        margin: 0;
        color: #9c899e;
        font-size: 12px;
    }


    /* =========================================
           USER
        ========================================= */

    .password-user {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        margin-bottom: 25px;
        border-radius: 19px;
        background: linear-gradient( 135deg, #fff4f8, #f7f2ff );
        border: 1px solid #f5e9f2;
    }


    .password-user-avatar {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: white;
        color: #d75c98;
        font-size: 21px;
        box-shadow: 0 5px 15px rgba(180, 100, 150, .09);
    }


    .password-user-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }


        .password-user-info span {
            font-size: 10px;
            color: #aa98aa;
        }


        .password-user-info strong {
            font-size: 14px;
            color: #5a425e;
        }


    /* =========================================
           FORM
        ========================================= */

    .password-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }


    .password-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }


        .password-field label {
            font-size: 13px;
            font-weight: 700;
            color: #624d65;
        }


    .password-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }


    .password-input {
        width: 100%;
        height: 53px;
        padding: 0 50px 0 48px;
        border: 1px solid #eadfeb;
        border-radius: 16px;
        outline: none;
        background: #fff;
        color: #503952;
        font-family: inherit;
        font-size: 13px;
        transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
    }


        .password-input::placeholder {
            color: #b7a8b8;
        }


        .password-input:focus {
            border-color: #d88ab1;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(216, 138, 177, .10);
        }


    .input-icon {
        position: absolute;
        right: 17px;
        z-index: 2;
        font-size: 17px;
        pointer-events: none;
    }


    .password-toggle {
        position: absolute;
        left: 9px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 11px;
        background: #faf3f8;
        cursor: pointer;
        font-size: 15px;
        transition: .2s ease;
    }


        .password-toggle:hover {
            background: #f5e5ef;
            transform: scale(1.05);
        }


    /* =========================================
           VALIDATION
        ========================================= */

    .password-validation {
        padding: 11px 14px;
        border-radius: 13px;
        background: #fff0f3;
        color: #c94d70;
        font-size: 12px;
    }


        .password-validation:empty {
            display: none;
        }


    .password-error {
        color: #d35476;
        font-size: 11px;
        padding-right: 4px;
    }


    /* =========================================
           SECURITY NOTICE
        ========================================= */

    .security-notice {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px;
        border-radius: 17px;
        background: linear-gradient( 135deg, #fff9ed, #fff5fa );
        border: 1px solid #f8ead7;
    }


    .security-notice-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #fff;
        font-size: 17px;
    }


    .security-notice strong {
        display: block;
        margin-bottom: 3px;
        color: #80633d;
        font-size: 12px;
    }


    .security-notice p {
        margin: 0;
        color: #9a866b;
        font-size: 11px;
        line-height: 1.9;
    }


    /* =========================================
           ACTIONS
        ========================================= */

    .password-actions {
        display: flex;
        gap: 10px;
        margin-top: 3px;
    }


    .password-submit {
        flex: 1;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 16px;
        background: linear-gradient( 135deg, #ff68a8, #a66cff );
        color: white;
        font-family: inherit;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(181, 92, 166, .20);
        transition: .25s ease;
    }


        .password-submit:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(181, 92, 166, .28);
        }


    .password-cancel {
        min-width: 105px;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        border: 1px solid #eadfeb;
        background: #fff;
        color: #806d83;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .25s ease;
    }


        .password-cancel:hover {
            color: #d05591;
            border-color: #e8bdd2;
            background: #fff7fb;
        }


    /* =========================================
           FOOTER
        ========================================= */

    .password-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid #f1e7f0;
        color: #b09eaf;
        font-size: 10px;
    }


    .footer-heart {
        color: #ed649e;
        animation: passwordHeart 1.5s ease-in-out infinite;
    }


    @@keyframes passwordHeart {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.2);
    }

    }


    /* =========================================
           MOBILE
        ========================================= */

    @@media (max-width: 576px) {
        .password-page

    {
        padding: 25px 15px;
    }


    .password-card {
        padding: 22px 18px;
        border-radius: 25px;
    }


    .password-header {
        gap: 12px;
    }


    .password-icon {
        width: 55px;
        height: 55px;
        border-radius: 17px;
        font-size: 24px;
    }


    .password-title h1 {
        font-size: 19px;
    }


    .password-title p {
        font-size: 10px;
    }


    .password-actions {
        flex-direction: column;
    }


    .password-cancel {
        width: 100%;
    }

    }
</style>
<div class="password-page" dir="rtl">

    <div class="password-container">

        <!-- Decorative background -->
        <div class="password-decoration decoration-one"></div>
        <div class="password-decoration decoration-two"></div>


        <!-- Card -->
        <div class="password-card">

            <!-- Header -->
            <div class="password-header">

                <div class="password-icon">
                    🔐
                </div>

                <div class="password-title">

                    <h1>
                        تغییر رمز عبور
                    </h1>

                    <p>
                        رمز عبور حساب کاربری خود را تغییر دهید
                    </p>

                </div>

            </div>


            <!-- User -->
            <div class="password-user">

                <div class="password-user-avatar">
                    ♡
                </div>

                <div class="password-user-info">

                    <span>
                        کاربر
                    </span>

                    <strong>
                        @Model.UserName
                    </strong>

                </div>

            </div>


            <!-- Form -->
            <form asp-action="ChangePassword"
                  asp-route-id="@Model.UserId"
                  method="post"
                  class="password-form">

                @Html.AntiForgeryToken()


                <!-- Validation -->
                <div asp-validation-summary="ModelOnly"
                     class="password-validation">
                </div>


                <!-- New Password -->
                <div class="password-field">

                    <label asp-for="NewPassword">
                    </label>

                    <div class="password-input-wrapper">

                        <span class="input-icon">
                            🔑
                        </span>

                        <input asp-for="NewPassword"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="رمز عبور جدید را وارد کنید" />

                        <button type="button"
                                class="password-toggle"
                                data-target="NewPassword"
                                aria-label="نمایش رمز عبور">

                            👁

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="password-error">
                    </span>

                </div>


                <!-- Confirm Password -->
                <div class="password-field">

                    <label asp-for="ConfirmPassword">
                    </label>

                    <div class="password-input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input asp-for="ConfirmPassword"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="رمز عبور را دوباره وارد کنید" />

                        <button type="button"
                                class="password-toggle"
                                data-target="ConfirmPassword"
                                aria-label="نمایش رمز عبور">

                            👁

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="password-error">
                    </span>

                </div>


                <!-- Security Notice -->
                <div class="security-notice">

                    <div class="security-notice-icon">
                        🛡️
                    </div>

                    <div>

                        <strong>
                            نکته امنیتی
                        </strong>

                        <p>
                            پس از تغییر رمز، نشست‌های قبلی این کاربر
                            بی‌اعتبار خواهند شد.
                        </p>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="password-actions">

                    <button type="submit"
                            class="password-submit">

                        <span>
                            🔐
                        </span>

                        <span>
                            تغییر رمز عبور
                        </span>

                    </button>


                    <a asp-action="Index"
                       class="password-cancel">

                        انصراف

                    </a>

                </div>

            </form>


            <!-- Footer -->
            <div class="password-footer">

                <span>
                    امنیت حساب شما اهمیت دارد
                </span>

                <span class="footer-heart">
                    ♥
                </span>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toggleButtons =
                document.querySelectorAll(".password-toggle");


            toggleButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const targetId =
                        button.getAttribute("data-target");

                    const input =
                        document.getElementById(targetId);


                    if (!input) {
                        return;
                    }


                    if (input.type === "password") {

                        input.type = "text";

                        button.textContent = "🙈";

                    }
                    else {

                        input.type = "password";

                        button.textContent = "👁";

                    }

                });

            });

        });

    </script>
}
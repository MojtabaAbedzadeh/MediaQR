@model MediaQR.Web.Models.Users.UserListViewModel

@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="container py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                مدیریت کاربران
            </h2>

            <p class="text-muted mb-0">
                مدیریت کاربران و نقش‌های سیستم
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            افزودن کاربر
        </a>

    </div>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0 align-middle">

                    <thead>
                        <tr>
                            <th>نام کاربری</th>
                            <th>ایمیل</th>
                            <th>نقش</th>
                            <th>ایمیل</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    کاربری وجود ندارد.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model.Users)
                            {
                                <tr>

                                    <td>
                                        @user.UserName
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @string.Join(", ", user.Roles)
                                    </td>

                                    <td>
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge bg-success">
                                                تأیید شده
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                تأیید نشده
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger">
                                                قفل شده
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                فعال
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="d-flex gap-1">

                                            @if (user.UserName != User.Identity?.Name)
                                            {
                                                <a asp-action="ChangePassword"
                                                   asp-route-id="@user.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    تغییر رمز
                                                </a>
                                            }

                                            @if (user.IsLockedOut)
                                            {
                                                <form asp-action="Unlock"
                                                      asp-route-id="@user.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        بازکردن قفل
                                                    </button>

                                                </form>
                                            }
                                            else if (user.UserName != User.Identity?.Name)
                                            {
                                                <form asp-action="Lock"
                                                      asp-route-id="@user.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">
                                                        قفل
                                                    </button>

                                                </form>
                                            }

                                            @if (user.UserName != User.Identity?.Name)
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@user.Id"
                                                      method="post"
                                                      onsubmit="return confirm('آیا از حذف این کاربر مطمئن هستید؟');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        حذف
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<style>

    .qr-filter {
        position: relative;
        min-width: 320px;
    }

    .qr-search-wrapper {
        position: relative;
    }

    .qr-search-input {
        width: 100%;
        height: 42px;
        padding: 0 42px 0 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #fff;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .qr-search-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

    .qr-clear-button {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        border: 0;
        background: transparent;
        font-size: 20px;
        line-height: 20px;
        cursor: pointer;
        color: #6b7280;
        display: none;
    }

        .qr-clear-button:hover {
            color: #111827;
        }

    .qr-search-results {
        position: absolute;
        z-index: 1000;
        top: calc(100% + 6px);
        right: 0;
        left: 0;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        max-height: 320px;
        overflow-y: auto;
        display: none;
    }

    .qr-search-item {
        padding: 12px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f3f4f6;
        transition: background 0.15s ease;
    }

        .qr-search-item:last-child {
            border-bottom: 0;
        }

        .qr-search-item:hover {
            background: #f9fafb;
        }

    .qr-search-item-title {
        font-weight: 600;
        color: #111827;
        font-size: 14px;
    }

    .qr-search-item-code {
        margin-top: 4px;
        font-size: 12px;
        color: #6b7280;
        direction: ltr;
        text-align: right;
    }

    .qr-search-item-media {
        margin-top: 3px;
        font-size: 12px;
        color: #9ca3af;
    }

    .qr-search-message {
        padding: 14px;
        text-align: center;
        color: #6b7280;
        font-size: 13px;
    }

    .selected-qr {
        margin-top: 8px;
        padding: 8px 12px;
        background: #f3f4f6;
        border-radius: 6px;
        font-size: 13px;
        color: #374151;
    }

        .selected-qr strong {
            color: #111827;
        }

    .analytics-dashboard {
        padding: 24px;
        max-width: 1600px;
        margin: 0 auto;
        color: #1f2937;
    }

    .analytics-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

        .analytics-header h1 {
            margin: 0 0 8px;
            font-size: 28px;
            font-weight: 700;
        }

        .analytics-header p {
            margin: 0;
            color: #6b7280;
        }

    .analytics-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .analytics-select,
    .analytics-date {
        height: 42px;
        padding: 0 12px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        min-width: 150px;
        font-family: inherit;
    }

    .analytics-button {
        height: 42px;
        padding: 0 20px;
        border: 0;
        border-radius: 10px;
        cursor: pointer;
        background: #2563eb;
        color: #fff;
        font-family: inherit;
        font-weight: 600;
    }

        .analytics-button:hover {
            opacity: .9;
        }

    .analytics-loading {
        padding: 14px 18px;
        margin-bottom: 20px;
        background: #eff6ff;
        border-radius: 10px;
        color: #1d4ed8;
    }

    .analytics-error {
        padding: 14px 18px;
        margin-bottom: 20px;
        background: #fef2f2;
        border-radius: 10px;
        color: #b91c1c;
    }

    .analytics-summary-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .analytics-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        min-height: 120px;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

    .analytics-card-title {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 14px;
    }

    .analytics-card-value {
        font-size: 30px;
        font-weight: 700;
        color: #111827;
    }

    .analytics-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }

    .analytics-panel-wide {
        margin-bottom: 20px;
    }

    .analytics-panel-header {
        margin-bottom: 20px;
    }

        .analytics-panel-header h2 {
            margin: 0 0 5px;
            font-size: 18px;
        }

        .analytics-panel-header span {
            color: #6b7280;
            font-size: 13px;
        }

    .analytics-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .analytics-chart-container {
        height: 360px;
        position: relative;
    }

        .analytics-chart-container.small {
            height: 300px;
        }

    @@media (max-width: 1200px) {

        .analytics-summary-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 800px) {

        .qr-filter {
            min-width: 100%;
            width: 100%;
        }

        .analytics-header {
            flex-direction: column;
        }

        .analytics-actions {
            width: 100%;
        }

        .analytics-select,
        .analytics-date {
            flex: 1;
        }

        .analytics-summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .analytics-grid-2 {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 500px) {

        .analytics-dashboard {
            padding: 12px;
        }

        .analytics-summary-grid {
            grid-template-columns: 1fr;
        }

        .analytics-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .analytics-select,
        .analytics-date,
        .analytics-button {
            width: 100%;
        }
    }

</style>

<div class="analytics-dashboard" dir="rtl">

    <!-- Header -->
    <div class="analytics-header">

        <div>
            <h1>داشبورد Analytics</h1>
            <p>
                آمار و رفتار کاربران در QR Code ها و فایل‌های رسانه‌ای
            </p>
        </div>

        <div class="analytics-actions">

            <div class="qr-filter">
                <label for="qrCodeSearch">QR Code</label>

                <div class="qr-search-wrapper">
                    <input type="text"
                           id="qrCodeSearch"
                           class="qr-search-input"
                           placeholder="جستجوی QR یا نام رسانه..."
                           autocomplete="off" />

                    <button type="button"
                            id="clearQrFilter"
                            class="qr-clear-button"
                            title="حذف فیلتر">
                        ×
                    </button>

                    <div id="qrSearchResults"
                         class="qr-search-results">
                    </div>
                </div>

                <div id="selectedQr"
                     class="selected-qr"
                     style="display:none;">
                </div>
            </div>

            <input type="date"
                   id="fromDate"
                   class="analytics-date" />

            <input type="date"
                   id="toDate"
                   class="analytics-date" />

            <button type="button"
                    id="applyFilters"
                    class="analytics-button">

                اعمال فیلتر

            </button>

        </div>

    </div>


    <!-- Loading -->
    <div id="analyticsLoading"
         class="analytics-loading">

        در حال دریافت اطلاعات...

    </div>


    <!-- Error -->
    <div id="analyticsError"
         class="analytics-error"
         style="display:none;">

        خطا هنگام دریافت اطلاعات Analytics.

    </div>


    <!-- Summary Cards -->
    <section id="summarySection"
             class="analytics-summary-grid">

        <div class="analytics-card">

            <div class="analytics-card-title">
                کل Scan
            </div>

            <div id="totalScans"
                 class="analytics-card-value">

                0

            </div>

        </div>


        <div class="analytics-card">

            <div class="analytics-card-title">
                بازدیدکننده یکتا
            </div>

            <div id="uniqueVisitors"
                 class="analytics-card-value">

                0

            </div>

        </div>


        <div class="analytics-card">

            <div class="analytics-card-title">
                Play
            </div>

            <div id="totalPlays"
                 class="analytics-card-value">

                0

            </div>

        </div>


        <div class="analytics-card">

            <div class="analytics-card-title">
                Pause
            </div>

            <div id="totalPauses"
                 class="analytics-card-value">

                0

            </div>

        </div>


        <div class="analytics-card">

            <div class="analytics-card-title">
                Completion Rate
            </div>

            <div id="completionRate"
                 class="analytics-card-value">

                0%

            </div>

        </div>


        <div class="analytics-card">

            <div class="analytics-card-title">
                میانگین مدت
            </div>

            <div id="averageDuration"
                 class="analytics-card-value">

                -

            </div>

        </div>

    </section>


    <!-- Timeline -->
    <section class="analytics-panel analytics-panel-wide">

        <div class="analytics-panel-header">

            <div>
                <h2>روند Analytics</h2>

                <span>
                    آمار روزانه Scan و Play
                </span>
            </div>

        </div>

        <div class="analytics-chart-container">

            <canvas id="timelineChart"></canvas>

        </div>

    </section>


    <!-- Device -->
    <section class="analytics-grid-2">

        <div class="analytics-panel">

            <div class="analytics-panel-header">

                <div>
                    <h2>نوع دستگاه</h2>
                    <span>Device</span>
                </div>

            </div>

            <div class="analytics-chart-container small">

                <canvas id="deviceChart"></canvas>

            </div>

        </div>


        <!-- OS -->
        <div class="analytics-panel">

            <div class="analytics-panel-header">

                <div>
                    <h2>سیستم عامل</h2>
                    <span>Operating System</span>
                </div>

            </div>

            <div class="analytics-chart-container small">

                <canvas id="osChart"></canvas>

            </div>

        </div>

    </section>


    <!-- Browser / Referrer -->
    <section class="analytics-grid-2">

        <div class="analytics-panel">

            <div class="analytics-panel-header">

                <div>
                    <h2>مرورگر</h2>
                    <span>Browser</span>
                </div>

            </div>

            <div class="analytics-chart-container small">

                <canvas id="browserChart"></canvas>

            </div>

        </div>


        <div class="analytics-panel">

            <div class="analytics-panel-header">

                <div>
                    <h2>منبع ورود</h2>
                    <span>Referrer</span>
                </div>

            </div>

            <div class="analytics-chart-container small">

                <canvas id="referrerChart"></canvas>

            </div>

        </div>

    </section>


    <!-- Country / City -->
    <section class="analytics-grid-2">

        <div class="analytics-panel">

            <div class="analytics-panel-header">

                <div>
                    <h2>کشورها</h2>
                    <span>Country</span>
                </div>

            </div>

            <div class="analytics-chart-container small">

                <canvas id="countryChart"></canvas>

            </div>

        </div>


        <div class="analytics-panel">

            <div class="analytics-panel-header">

                <div>
                    <h2>شهرها</h2>
                    <span>City</span>
                </div>

            </div>

            <div class="analytics-chart-container small">

                <canvas id="cityChart"></canvas>

            </div>

        </div>

    </section>

</div>


@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let selectedQrCodeId = null;
        let qrSearchTimer = null;
        let qrSearchAbortController = null;

        (() => {

            "use strict";

            const state = {
                charts: {}
            };


            const $ = (selector) =>
                document.querySelector(selector);


            const formatNumber = (value) => {

                if (value === null || value === undefined) {
                    return "0";
                }

                return Number(value).toLocaleString("fa-IR");

            };


            const formatPercent = (value) => {

                if (value === null || value === undefined) {
                    return "0%";
                }

                return Number(value).toLocaleString(
                    "fa-IR",
                    {
                        maximumFractionDigits: 2
                    }
                ) + "%";

            };


            const formatDuration = (seconds) => {

                if (
                    seconds === null ||
                    seconds === undefined ||
                    Number.isNaN(Number(seconds))
                ) {
                    return "-";
                }

                const totalSeconds =
                    Math.round(Number(seconds));

                const minutes =
                    Math.floor(totalSeconds / 60);

                const remaining =
                    totalSeconds % 60;

                return `${minutes} دقیقه و ${remaining} ثانیه`;

            };


        const buildQueryString = () => {
            const params = new URLSearchParams();

            const from = $("#fromDate").value;
            const to = $("#toDate").value;

            if (selectedQrCodeId) {
                params.set("qrCodeId", selectedQrCodeId);
            }

            if (from) {
                params.set("from", `${from}T00:00:00`);
            }

            if (to) {
                params.set("to", `${to}T23:59:59.999`);
            }

            const value = params.toString();

            return value ? `?${value}` : "";
        };


            const apiGet = async (url) => {

                const response =
                    await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                if (!response.ok) {
                    throw new Error(
                        `HTTP ${response.status}`
                    );
                }

                const result =
                    await response.json();

                if (!result.success) {
                    throw new Error(
                        result.message ||
                        "خطا هنگام دریافت اطلاعات."
                    );
                }

                return result.data;

            };


            const destroyChart = (name) => {

                if (state.charts[name]) {

                    state.charts[name].destroy();

                    state.charts[name] = null;
                }

            };


            const createPieChart = (
                name,
                elementId,
                rows
            ) => {

                destroyChart(name);

                const canvas =
                    document.getElementById(elementId);

                if (!canvas) {
                    return;
                }

                state.charts[name] =
                    new Chart(
                        canvas,
                        {
                            type: "doughnut",

                            data: {
                                labels:
                                    rows.map(x => x.name),

                                datasets: [{
                                    data:
                                        rows.map(x => x.count)
                                }]
                            },

                            options: {
                                responsive: true,
                                maintainAspectRatio: false,

                                plugins: {
                                    legend: {
                                        position: "bottom",
                                        rtl: true
                                    }
                                }
                            }
                        }
                    );

            };


            const createBarChart = (
                name,
                elementId,
                rows
            ) => {

                destroyChart(name);

                const canvas =
                    document.getElementById(elementId);

                if (!canvas) {
                    return;
                }

                state.charts[name] =
                    new Chart(
                        canvas,
                        {
                            type: "bar",

                            data: {
                                labels:
                                    rows.map(x => x.name),

                                datasets: [{
                                    label: "تعداد",

                                    data:
                                        rows.map(x => x.count)
                                }]
                            },

                            options: {
                                responsive: true,
                                maintainAspectRatio: false,

                                plugins: {
                                    legend: {
                                        display: false
                                    }
                                },

                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                }
                            }
                        }
                    );

            };


            const createTimelineChart = (
                rows
            ) => {

                destroyChart("timeline");

                const canvas =
                    document.getElementById(
                        "timelineChart"
                    );

                if (!canvas) {
                    return;
                }

                state.charts.timeline =
                    new Chart(
                        canvas,
                        {
                            type: "line",

                            data: {

                                labels:
                                    rows.map(x =>
                                        new Date(
                                            x.date
                                        ).toLocaleDateString(
                                            "fa-IR"
                                        )
                                    ),

                                datasets: [

                                    {
                                        label: "Scan",

                                        data:
                                            rows.map(
                                                x =>
                                                    x.totalScans
                                            ),

                                        tension: .3
                                    },

                                    {
                                        label: "Play",

                                        data:
                                            rows.map(
                                                x =>
                                                    x.totalPlays
                                            ),

                                        tension: .3
                                    }

                                ]

                            },

                            options: {
                                responsive: true,
                                maintainAspectRatio: false,

                                interaction: {
                                    mode: "index",
                                    intersect: false
                                },

                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                }
                            }
                        }
                    );

            };


            const loadSummary = async () => {

                const data =
                    await apiGet(
                        `/api/analytics/summary${buildQueryString()}`
                    );

                $("#totalScans").textContent =
                    formatNumber(data.totalScans);

                $("#uniqueVisitors").textContent =
                    formatNumber(data.uniqueVisitors);

                $("#totalPlays").textContent =
                    formatNumber(data.totalPlays);

                $("#totalPauses").textContent =
                    formatNumber(data.totalPauses);

                $("#completionRate").textContent =
                    formatPercent(data.completionRate);

                $("#averageDuration").textContent =
                    formatDuration(
                        data.averageDurationSeconds
                    );

            };


            const loadTimeline = async () => {

                const data =
                    await apiGet(
                        `/api/analytics/timeline${buildQueryString()}`
                    );

                createTimelineChart(data);

            };


            const loadBreakdown = async (
                type,
                chartName,
                elementId,
                chartType = "pie"
            ) => {

                const data =
                    await apiGet(
                        `/api/analytics/breakdown/${type}${buildQueryString()}`
                    );

                if (chartType === "bar") {

                    createBarChart(
                        chartName,
                        elementId,
                        data
                    );

                } else {

                    createPieChart(
                        chartName,
                        elementId,
                        data
                    );

                }

            };


            const loadQrCodes = async () => {

                /*
                 * فعلاً از API موجود استفاده نمی‌کنیم.
                 *
                 * در مرحله بعد endpoint اختصاصی
                 * برای لیست QR Code ها اضافه می‌شود.
                 *
                 * تا آن زمان فیلتر «همه QR Code ها»
                 * فعال است.
                 */

            };

        const searchQrCodes = async (search) => {
            if (qrSearchAbortController) {
                qrSearchAbortController.abort();
            }

            qrSearchAbortController =
                new AbortController();

            const results = $("#qrSearchResults");

            results.innerHTML = `
                <div class="qr-search-message">
                    در حال جستجو...
                </div>
            `;

            results.style.display = "block";

            try {
                const params = new URLSearchParams();

                params.set("search", search);
                params.set("page", "1");
                params.set("pageSize", "20");

                const response = await fetch(
                    `/api/analytics/qr-codes?${params.toString()}`,
                    {
                        method: "GET",
                        signal: qrSearchAbortController.signal,
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                if (!response.ok) {
                    throw new Error(
                        "خطا در دریافت QR Code ها.");
                }

                const result = await response.json();

                if (!result.success) {
                    throw new Error(
                        result.message ||
                        "خطا در جستجوی QR Code.");
                }

                renderQrSearchResults(
                    result.data.items || []);

            } catch (error) {

                if (error.name === "AbortError") {
                    return;
                }

                console.error(
                    "QR search error:",
                    error);

                results.innerHTML = `
                    <div class="qr-search-message">
                        خطا در جستجوی QR Code
                    </div>
                `;
            }
        };

                const renderQrSearchResults = (items) => {
            const results = $("#qrSearchResults");

            if (!items.length) {
                results.innerHTML = `
                    <div class="qr-search-message">
                        QR Code موردنظر پیدا نشد.
                    </div>
                `;

                results.style.display = "block";

                return;
            }

            results.innerHTML = items.map(item => {

                const title =
                    item.title ||
                    "بدون عنوان";

                const mediaTitle =
                    item.mediaTitle ||
                    "بدون رسانه";

                return `
                    <div
                        class="qr-search-item"
                        data-qr-id="${item.id}"
                        data-qr-title="${escapeHtml(title)}"
                        data-media-title="${escapeHtml(mediaTitle)}">

                        <div class="qr-search-item-title">
                            ${escapeHtml(title)}
                        </div>

                        <div class="qr-search-item-code">
                            ${escapeHtml(item.code)}
                        </div>

                        <div class="qr-search-item-media">
                            رسانه: ${escapeHtml(mediaTitle)}
                        </div>
                    </div>
                `;

            }).join("");

            results.style.display = "block";
        };

        const escapeHtml = (value) => {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        };

            $("#qrCodeSearch").addEventListener(
        "input",
        function () {

            const search =
                this.value.trim();

            $("#clearQrFilter").style.display =
                search
                    ? "block"
                    : "none";

            clearTimeout(qrSearchTimer);

            if (search.length < 2) {
                $("#qrSearchResults").style.display =
                    "none";

                return;
            }

            qrSearchTimer = setTimeout(
                () => searchQrCodes(search),
                300);
        });

            $("#qrSearchResults").addEventListener(
        "click",
        async function (event) {

            const item =
                event.target.closest(
                    ".qr-search-item");

            if (!item) {
                return;
            }

            selectedQrCodeId =
                Number(item.dataset.qrId);

            const title =
                item.dataset.qrTitle;

            const mediaTitle =
                item.dataset.mediaTitle;

            $("#qrCodeSearch").value =
                title;

            $("#qrSearchResults").style.display =
                "none";

            $("#selectedQr").innerHTML = `
                <strong>QR انتخاب‌شده:</strong>
                ${escapeHtml(title)}
                <span> — ${escapeHtml(mediaTitle)}</span>
            `;

            $("#selectedQr").style.display =
                "block";

            $("#clearQrFilter").style.display =
                "block";

            await loadDashboard();
        });

            $("#clearQrFilter").addEventListener(
        "click",
        async function () {

            selectedQrCodeId = null;

            $("#qrCodeSearch").value = "";

            $("#selectedQr").style.display =
                "none";

            $("#selectedQr").innerHTML = "";

            $("#qrSearchResults").style.display =
                "none";

            $("#clearQrFilter").style.display =
                "none";

            await loadDashboard();
        });

            document.addEventListener(
        "click",
        function (event) {

            const wrapper =
                event.target.closest(
                    ".qr-search-wrapper");

            if (!wrapper) {
                $("#qrSearchResults")
                    .style.display = "none";
            }
        });

            const loadDashboard = async () => {

                const loading =
                    $("#analyticsLoading");

                const error =
                    $("#analyticsError");

                loading.style.display =
                    "block";

                error.style.display =
                    "none";

                try {

                    await Promise.all([

                        loadSummary(),

                        loadTimeline(),

                        loadBreakdown(
                            "device",
                            "device",
                            "deviceChart"
                        ),

                        loadBreakdown(
                            "os",
                            "os",
                            "osChart"
                        ),

                        loadBreakdown(
                            "browser",
                            "browser",
                            "browserChart"
                        ),

                        loadBreakdown(
                            "referrer",
                            "referrer",
                            "referrerChart",
                            "bar"
                        ),

                        loadBreakdown(
                            "country",
                            "country",
                            "countryChart",
                            "bar"
                        ),

                        loadBreakdown(
                            "city",
                            "city",
                            "cityChart",
                            "bar"
                        )

                    ]);

                }
                catch (errorObject) {

                    console.error(
                        errorObject
                    );

                    error.style.display =
                        "block";

                }
                finally {

                    loading.style.display =
                        "none";

                }

            };


            $("#applyFilters")
                .addEventListener(
                    "click",
                    loadDashboard
                );


            document.addEventListener(
                "DOMContentLoaded",
                async () => {

                    await loadQrCodes();

                    await loadDashboard();

                }
            );

        })();

    </script>
}
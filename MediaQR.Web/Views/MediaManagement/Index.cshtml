@model IReadOnlyList<MediaQR.Application.DTOs.Media.MediaListItemDto>

@using MediaQR.Web.Helpers

@{
    ViewData["Title"] = "مدیریت رسانه‌ها";

    var totalMedia = Model.Count;
    var activeMedia = Model.Count(x => x.IsActive);
    var inactiveMedia = Model.Count(x => !x.IsActive);
    var totalQr = Model.Sum(x => x.QrCount);
}

<style>

    .media-list-page {
        min-height: calc(100vh - 70px);
        padding: 32px 20px 50px;
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 10% 10%, rgba(244, 114, 182, .10), transparent 30%), radial-gradient(circle at 90% 20%, rgba(139, 92, 246, .10), transparent 30%), linear-gradient(135deg, #fff7fb 0%, #f8f5ff 50%, #f4f8ff 100%);
    }

        .media-list-page::before,
        .media-list-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(5px);
            pointer-events: none;
        }

        .media-list-page::before {
            width: 280px;
            height: 280px;
            top: -100px;
            right: -80px;
            background: rgba(244, 114, 182, .10);
        }

        .media-list-page::after {
            width: 320px;
            height: 320px;
            bottom: -150px;
            left: -100px;
            background: rgba(139, 92, 246, .08);
        }

    .media-list-wrapper {
        max-width: 1500px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    /* =========================
           Header
           ========================= */

    .media-list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .media-list-header-main {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .media-list-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        font-size: 27px;
        color: white;
        background: linear-gradient(135deg, #ec4899, #8b5cf6);
        box-shadow: 0 12px 28px rgba(139, 92, 246, .22);
    }

    .media-list-title {
        margin: 0 0 5px;
        font-size: 28px;
        font-weight: 800;
        color: #29223a;
    }

    .media-list-subtitle {
        margin: 0;
        color: #8b8195;
        font-size: 14px;
    }

    .media-create-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 46px;
        padding: 0 20px;
        border: 0;
        border-radius: 14px;
        color: #fff !important;
        text-decoration: none !important;
        font-weight: 700;
        background: linear-gradient(135deg, #ec4899, #8b5cf6);
        box-shadow: 0 10px 24px rgba(139, 92, 246, .20);
        transition: all .2s ease;
    }

        .media-create-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(139, 92, 246, .28);
        }

        .media-create-button i {
            font-size: 17px;
        }

    /* =========================
           Alerts
           ========================= */

    .media-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 0;
        border-radius: 16px;
        padding: 15px 18px;
        margin-bottom: 20px;
        box-shadow: 0 8px 24px rgba(40, 30, 60, .06);
    }

    .media-alert-success {
        background: linear-gradient( 135deg, rgba(34, 197, 94, .10), rgba(16, 185, 129, .06) );
        color: #166534;
    }

    .media-alert-danger {
        background: linear-gradient( 135deg, rgba(239, 68, 68, .10), rgba(244, 63, 94, .06) );
        color: #991b1b;
    }

    .media-alert-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(255,255,255,.7);
        font-size: 17px;
    }

    .media-alert-content {
        flex: 1;
        padding-top: 5px;
    }

    .media-alert-close {
        border: 0;
        background: transparent;
        opacity: .6;
    }

    /* =========================
           Statistics
           ========================= */

    .media-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .media-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 112px;
        padding: 20px;
        border: 1px solid rgba(255,255,255,.75);
        border-radius: 20px;
        background: rgba(255,255,255,.76);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 10px 30px rgba(55, 40, 80, .07);
    }

        .media-stat-card::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            left: -35px;
            bottom: -45px;
            opacity: .08;
        }

    .media-stat-card-pink::after {
        background: #ec4899;
    }

    .media-stat-card-purple::after {
        background: #8b5cf6;
    }

    .media-stat-card-green::after {
        background: #10b981;
    }

    .media-stat-card-blue::after {
        background: #3b82f6;
    }

    .media-stat-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .media-stat-label {
        color: #8c8395;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .media-stat-value {
        color: #30283d;
        font-size: 27px;
        line-height: 1;
        font-weight: 800;
    }

    .media-stat-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 21px;
    }

    .media-stat-icon-pink {
        color: #db2777;
        background: rgba(236,72,153,.10);
    }

    .media-stat-icon-purple {
        color: #7c3aed;
        background: rgba(139,92,246,.10);
    }

    .media-stat-icon-green {
        color: #059669;
        background: rgba(16,185,129,.10);
    }

    .media-stat-icon-blue {
        color: #2563eb;
        background: rgba(59,130,246,.10);
    }

    /* =========================
           Main card
           ========================= */

    .media-table-card {
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.8);
        border-radius: 24px;
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 15px 45px rgba(55, 40, 80, .08);
    }

    .media-table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 24px;
        border-bottom: 1px solid rgba(100, 80, 120, .08);
    }

    .media-table-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #332b40;
        font-weight: 800;
        font-size: 16px;
    }

    .media-table-title-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        color: #7c3aed;
        background: rgba(139,92,246,.10);
    }

    .media-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 28px;
        padding: 0 10px;
        border-radius: 20px;
        color: #7c3aed;
        background: rgba(139,92,246,.09);
        font-size: 12px;
        font-weight: 700;
    }

    .media-table-wrapper {
        overflow-x: auto;
    }

    .media-table {
        width: 100%;
        min-width: 1050px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .media-table thead th {
            padding: 15px 18px;
            border-bottom: 1px solid rgba(100, 80, 120, .08);
            background: rgba(248,246,251,.72);
            color: #8a8193;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .media-table tbody td {
            padding: 18px;
            border-bottom: 1px solid rgba(100, 80, 120, .065);
            color: #4b4353;
            font-size: 13px;
            vertical-align: middle;
        }

        .media-table tbody tr {
            transition: background .18s ease;
        }

            .media-table tbody tr:hover {
                background: rgba(250,247,253,.75);
            }

            .media-table tbody tr:last-child td {
                border-bottom: 0;
            }

    /* =========================
           Title / description
           ========================= */

    .media-title-cell {
        max-width: 300px;
    }

    .media-title {
        color: #352d40;
        font-size: 14px;
        font-weight: 750;
        margin-bottom: 5px;
    }

    .media-description {
        display: block;
        max-width: 290px;
        color: #9a91a2;
        font-size: 11px;
        line-height: 1.7;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* =========================
           File
           ========================= */

    .media-file-cell {
        max-width: 270px;
    }

    .media-file-name {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #4a4252;
        font-weight: 600;
        word-break: break-word;
    }

        .media-file-name i {
            color: #9b8ca8;
        }

    .media-content-type {
        display: block;
        margin-top: 5px;
        color: #a29aa9;
        font-size: 10px;
        direction: ltr;
        text-align: right;
    }

    /* =========================
           Type badges
           ========================= */

    .media-type-badge,
    .media-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .media-type-image {
        color: #0891b2;
        background: rgba(6,182,212,.10);
    }

    .media-type-audio {
        color: #b45309;
        background: rgba(245,158,11,.12);
    }

    .media-type-video {
        color: #6d28d9;
        background: rgba(139,92,246,.11);
    }

    .media-type-default {
        color: #64748b;
        background: rgba(100,116,139,.10);
    }

    .media-status-active {
        color: #047857;
        background: rgba(16,185,129,.10);
    }

    .media-status-inactive {
        color: #64748b;
        background: rgba(100,116,139,.10);
    }

    /* =========================
           QR
           ========================= */

    .qr-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 32px;
        padding: 0 9px;
        border-radius: 10px;
        color: #7c3aed;
        background: rgba(139,92,246,.09);
        font-weight: 800;
        font-size: 12px;
    }

    /* =========================
           Date
           ========================= */

    .media-date {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #6f6678;
        white-space: nowrap;
        font-size: 12px;
    }

        .media-date i {
            color: #a78bfa;
            font-size: 14px;
        }

    /* =========================
           Actions
           ========================= */

    .media-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        white-space: nowrap;
    }

    .media-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 34px;
        padding: 0 11px;
        border: 1px solid rgba(124,58,237,.15);
        border-radius: 10px;
        background: rgba(255,255,255,.75);
        color: #6d28d9;
        text-decoration: none !important;
        font-size: 11px;
        font-weight: 700;
        transition: all .18s ease;
    }

        .media-action-button:hover {
            color: #fff;
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            border-color: transparent;
            transform: translateY(-1px);
        }

    /* =========================
           Empty state
           ========================= */

    .media-empty {
        padding: 75px 25px;
        text-align: center;
    }

    .media-empty-icon {
        width: 78px;
        height: 78px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        color: #8b5cf6;
        background: linear-gradient( 135deg, rgba(236,72,153,.10), rgba(139,92,246,.10) );
        font-size: 32px;
    }

    .media-empty-title {
        margin-bottom: 8px;
        color: #3b3345;
        font-size: 18px;
        font-weight: 800;
    }

    .media-empty-text {
        margin-bottom: 22px;
        color: #938a9b;
        font-size: 13px;
    }

    /* =========================
           Responsive
           ========================= */

    @@media (max-width: 1000px) {

        .media-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .media-list-header {
            align-items: flex-start;
        }
    }

    @@media (max-width: 650px) {

        .media-list-page {
            padding: 22px 12px 40px;
        }

        .media-list-header {
            flex-direction: column;
        }

        .media-list-header-main {
            width: 100%;
        }

        .media-create-button {
            width: 100%;
        }

        .media-list-title {
            font-size: 23px;
        }

        .media-list-icon {
            width: 50px;
            height: 50px;
            flex-basis: 50px;
            border-radius: 15px;
        }

        .media-stat-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .media-stat-card {
            min-height: 100px;
            padding: 15px;
        }

        .media-stat-value {
            font-size: 22px;
        }

        .media-stat-icon {
            width: 40px;
            height: 40px;
            flex-basis: 40px;
            border-radius: 12px;
        }

        .media-table-card {
            border-radius: 18px;
        }

        .media-table-card-header {
            padding: 16px;
        }
    }

    @@media (max-width: 400px) {

        .media-stat-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="media-list-page" dir="rtl">

    <div class="media-list-wrapper">

        <!-- =========================
             Header
             ========================= -->

        <div class="media-list-header">

            <div class="media-list-header-main">

                <div class="media-list-icon">
                    <i class="bi bi-collection-play"></i>
                </div>

                <div>

                    <h1 class="media-list-title">
                        مدیریت رسانه‌ها
                    </h1>

                    <p class="media-list-subtitle">
                        مدیریت فایل‌های تصویر، صوت و ویدئو
                    </p>

                </div>

            </div>


            <a asp-controller="Media"
               asp-action="Create"
               class="media-create-button">

                <i class="bi bi-plus-lg"></i>

                <span>
                    افزودن رسانه
                </span>

            </a>

        </div>


        <!-- =========================
             Alerts
             ========================= -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="media-alert media-alert-success">

                <div class="media-alert-icon">
                    <i class="bi bi-check-lg"></i>
                </div>

                <div class="media-alert-content">
                    @TempData["SuccessMessage"]
                </div>

                <button type="button"
                        class="media-alert-close"
                        data-bs-dismiss="alert"
                        aria-label="بستن">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <div class="media-alert media-alert-danger">

                <div class="media-alert-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <div class="media-alert-content">
                    @TempData["ErrorMessage"]
                </div>

                <button type="button"
                        class="media-alert-close"
                        data-bs-dismiss="alert"
                        aria-label="بستن">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>
        }


        <!-- =========================
             Statistics
             ========================= -->

        <div class="media-stat-grid">

            <div class="media-stat-card media-stat-card-pink">

                <div class="media-stat-content">

                    <div>
                        <div class="media-stat-label">
                            کل رسانه‌ها
                        </div>

                        <div class="media-stat-value">
                            @totalMedia
                        </div>
                    </div>

                    <div class="media-stat-icon media-stat-icon-pink">
                        <i class="bi bi-collection-play"></i>
                    </div>

                </div>

            </div>


            <div class="media-stat-card media-stat-card-green">

                <div class="media-stat-content">

                    <div>
                        <div class="media-stat-label">
                            رسانه‌های فعال
                        </div>

                        <div class="media-stat-value">
                            @activeMedia
                        </div>
                    </div>

                    <div class="media-stat-icon media-stat-icon-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

            </div>


            <div class="media-stat-card media-stat-card-purple">

                <div class="media-stat-content">

                    <div>
                        <div class="media-stat-label">
                            رسانه‌های غیرفعال
                        </div>

                        <div class="media-stat-value">
                            @inactiveMedia
                        </div>
                    </div>

                    <div class="media-stat-icon media-stat-icon-purple">
                        <i class="bi bi-pause-circle"></i>
                    </div>

                </div>

            </div>


            <div class="media-stat-card media-stat-card-blue">

                <div class="media-stat-content">

                    <div>
                        <div class="media-stat-label">
                            مجموع QR Code
                        </div>

                        <div class="media-stat-value">
                            @totalQr
                        </div>
                    </div>

                    <div class="media-stat-icon media-stat-icon-blue">
                        <i class="bi bi-qr-code"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             Media table
             ========================= -->

        <div class="media-table-card">

            <div class="media-table-card-header">

                <div class="media-table-title">

                    <div class="media-table-title-icon">
                        <i class="bi bi-files"></i>
                    </div>

                    <span>
                        لیست رسانه‌ها
                    </span>

                </div>


                <span class="media-count-badge">
                    @Model.Count رسانه
                </span>

            </div>


            @if (!Model.Any())
            {
                <!-- Empty -->

                <div class="media-empty">

                    <div class="media-empty-icon">
                        <i class="bi bi-images"></i>
                    </div>

                    <div class="media-empty-title">
                        هنوز هیچ رسانه‌ای ثبت نشده است
                    </div>

                    <div class="media-empty-text">
                        اولین تصویر، فایل صوتی یا ویدئوی خود را ایجاد کنید.
                    </div>

                    <a asp-controller="Media"
                       asp-action="Create"
                       class="media-create-button">

                        <i class="bi bi-plus-lg"></i>

                        افزودن اولین رسانه

                    </a>

                </div>
            }
            else
            {
                <div class="media-table-wrapper">

                    <table class="media-table">

                        <thead>

                            <tr>

                                <th>
                                    عنوان
                                </th>

                                <th>
                                    فایل
                                </th>

                                <th>
                                    نوع
                                </th>

                                <th>
                                    حجم
                                </th>

                                <th>
                                    QR
                                </th>

                                <th>
                                    وضعیت
                                </th>

                                <th>
                                    تاریخ ایجاد
                                </th>

                                <th class="text-center">
                                    عملیات
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var media in Model)
                            {
                                <tr>

                                    <!-- عنوان -->

                                    <td class="media-title-cell">

                                        <div class="media-title">
                                            @media.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(media.Description))
                                        {
                                            <span class="media-description"
                                                  title="@media.Description">

                                                @media.Description

                                            </span>
                                        }

                                    </td>


                                    <!-- فایل -->

                                    <td class="media-file-cell">

                                        <div class="media-file-name">

                                            @switch (media.MediaType)
                                            {
                                                case "Image":
                                                    <i class="bi bi-image"></i>
                                                    break;

                                                case "Audio":
                                                    <i class="bi bi-music-note-beamed"></i>
                                                    break;

                                                case "Video":
                                                    <i class="bi bi-camera-video"></i>
                                                    break;

                                                default:
                                                    <i class="bi bi-file-earmark"></i>
                                                    break;
                                            }

                                            <span>
                                                @media.OriginalFileName
                                            </span>

                                        </div>

                                        <span class="media-content-type">
                                            @media.ContentType
                                        </span>

                                    </td>


                                    <!-- نوع -->

                                    <td>

                                        @switch (media.MediaType)
                                        {
                                            case "Image":

                                                <span class="media-type-badge media-type-image">

                                                    <i class="bi bi-image"></i>

                                                    تصویر

                                                </span>

                                                break;

                                            case "Audio":

                                                <span class="media-type-badge media-type-audio">

                                                    <i class="bi bi-volume-up"></i>

                                                    صوت

                                                </span>

                                                break;

                                            case "Video":

                                                <span class="media-type-badge media-type-video">

                                                    <i class="bi bi-play-btn"></i>

                                                    ویدئو

                                                </span>

                                                break;

                                            default:

                                                <span class="media-type-badge media-type-default">

                                                    <i class="bi bi-file-earmark"></i>

                                                    @media.MediaType

                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- حجم -->

                                    <td>

                                        <span>
                                            @FormatFileSize(media.FileSize)
                                        </span>

                                    </td>


                                    <!-- QR -->

                                    <td>

                                        <span class="qr-count">

                                            <i class="bi bi-qr-code me-1"></i>

                                            @media.QrCount

                                        </span>

                                    </td>


                                    <!-- وضعیت -->

                                    <td>

                                        @if (media.IsActive)
                                        {
                                            <span class="media-status-badge media-status-active">

                                                <i class="bi bi-check-circle"></i>

                                                فعال

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="media-status-badge media-status-inactive">

                                                <i class="bi bi-pause-circle"></i>

                                                غیرفعال

                                            </span>
                                        }

                                    </td>


                                    <!-- تاریخ -->

                                    <td>

                                        <span class="media-date">

                                            <i class="bi bi-calendar3"></i>

                                            @PersianDateHelper.ToPersianDateTime(
                                            media.CreatedAt.ToLocalTime()
                                                                        )

                                </span>

                            </td>


                            <!-- عملیات -->

                            <td>

                                <div class="media-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@media.Id"
                                       class="media-action-button">

                                        <i class="bi bi-eye"></i>

                                        جزئیات

                                    </a>

                                </div>

                            </td>

                        </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


@functions
{
    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes:N0} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:N2} KB";

        if (bytes < 1024L * 1024L * 1024L)
            return $"{bytes / (1024d * 1024d):N2} MB";

        return $"{bytes / (1024d * 1024d * 1024d):N2} GB";
    }
}
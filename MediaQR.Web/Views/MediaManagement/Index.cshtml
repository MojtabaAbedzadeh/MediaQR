@model IReadOnlyList<MediaQR.Application.DTOs.Media.MediaListItemDto>

@{
    ViewData["Title"] = "مدیریت رسانه‌ها";
}

<div class="container-fluid mt-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                مدیریت رسانه‌ها
            </h1>

            <div class="text-muted">
                مدیریت فایل‌های تصویر، صوت و ویدئو
            </div>
        </div>

        <div>
            <a asp-controller="Media"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                افزودن رسانه
            </a>
        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <strong>
                    لیست رسانه‌ها
                </strong>

                <span class="badge bg-secondary">
                    @Model.Count رسانه
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center p-5">

                    <div class="text-muted mb-3">
                        هنوز هیچ رسانه‌ای ثبت نشده است.
                    </div>

                    <a asp-controller="Media"
                       asp-action="Create"
                       class="btn btn-primary">
                        افزودن اولین رسانه
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    عنوان
                                </th>

                                <th>
                                    فایل
                                </th>

                                <th>
                                    نوع
                                </th>

                                <th>
                                    حجم
                                </th>

                                <th>
                                    QR
                                </th>

                                <th>
                                    وضعیت
                                </th>

                                <th>
                                    تاریخ ایجاد
                                </th>

                                <th class="text-center">
                                    عملیات
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var media in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @media.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(media.Description))
                                        {
                                            <small class="text-muted">
                                                @media.Description
                                            </small>
                                        }

                                    </td>

                                    <td>

                                        <div>
                                            @media.OriginalFileName
                                        </div>

                                        <small class="text-muted">
                                            @media.ContentType
                                        </small>

                                    </td>

                                    <td>

                                        @switch (media.MediaType)
                                        {
                                            case "Image":
                                                <span class="badge bg-info">
                                                    تصویر
                                                </span>
                                                break;

                                            case "Audio":
                                                <span class="badge bg-warning text-dark">
                                                    صوت
                                                </span>
                                                break;

                                            case "Video":
                                                <span class="badge bg-primary">
                                                    ویدئو
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @media.MediaType
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td>
                                        @FormatFileSize(media.FileSize)
                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">
                                            @media.QrCount
                                        </span>

                                    </td>

                                    <td>

                                        @if (media.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                غیرفعال
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @media.CreatedAt.ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@media.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                جزئیات
                                            </a>

                                            <div class="btn-group">

                                                <a asp-action="Details"
                                                   asp-route-id="@media.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    جزئیات
                                                </a>

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@functions
{
    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes:N0} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:N2} KB";

        if (bytes < 1024L * 1024L * 1024L)
            return $"{bytes / (1024d * 1024d):N2} MB";

        return $"{bytes / (1024d * 1024d * 1024d):N2} GB";
    }
}
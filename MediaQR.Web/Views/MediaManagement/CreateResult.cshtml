@model MediaQR.Application.DTOs.Media.CreateMediaResultDto

@{
    ViewData["Title"] = "رسانه ایجاد شد";

    var qrImageSrc =
        $"data:image/png;base64,{Model.QrImageBase64}";

    var qrFileName =
        $"qr-{Model.QrCode}.png";
}

<div class="container mt-5 mb-5" dir="rtl">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-5 text-center">

                    <div class="mb-4">

                        <div class="display-5 text-success">
                            ✓
                        </div>

                        <h1 class="h3 mt-3">
                            رسانه با موفقیت ایجاد شد
                        </h1>

                        <p class="text-muted">
                            رسانه ثبت شده و QR Code اختصاصی آن ایجاد شد.
                        </p>

                    </div>


                    <!-- اطلاعات -->

                    <div class="border rounded p-4 mb-4 text-start">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="text-muted small">
                                    عنوان
                                </div>

                                <div class="fw-semibold">
                                    @Model.Title
                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="text-muted small">
                                    فایل
                                </div>

                                <div>
                                    @Model.OriginalFileName
                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="text-muted small">
                                    نوع رسانه
                                </div>

                                <div>
                                    @Model.MediaType
                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="text-muted small">
                                    کد QR
                                </div>

                                <code>
                                    @Model.QrCode
                                </code>

                            </div>

                        </div>

                    </div>


                    <!-- QR -->

                    <div class="mb-4">

                        <h2 class="h5 mb-3">
                            QR Code
                        </h2>

                        <div class="border rounded p-4 d-inline-block">

                            <img src="@qrImageSrc"
                                 alt="QR Code"
                                 class="img-fluid"
                                 style="width:300px;height:300px;" />

                        </div>

                    </div>


                    <!-- URL -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            آدرس QR
                        </label>

                        <div class="input-group">

                            <input type="text"
                                   class="form-control"
                                   value="@Model.QrUrl"
                                   readonly />

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    onclick="copyQrUrl()">
                                کپی
                            </button>

                        </div>

                    </div>


                    <!-- عملیات -->

                    <div class="d-flex justify-content-center flex-wrap gap-2">

                        <a href="@qrImageSrc"
                           download="@qrFileName"
                           class="btn btn-success">
                            دانلود QR
                        </a>

                        <a href="@Model.QrUrl"
                           target="_blank"
                           class="btn btn-primary">
                            مشاهده رسانه
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@Model.MediaFileId"
                           class="btn btn-outline-primary">
                            جزئیات رسانه
                        </a>

                        <a asp-controller="QrManagement"
                           asp-action="Details"
                           asp-route-id="@Model.QrCodeId"
                           class="btn btn-outline-secondary">
                            مدیریت QR
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>
        function copyQrUrl() {
            const input =
                document.querySelector(
                    'input[readonly]'
                );

            if (!input) {
                return;
            }

            navigator.clipboard.writeText(input.value)
                .then(function () {
                    alert('آدرس QR کپی شد.');
                })
                .catch(function () {
                    input.select();
                    document.execCommand('copy');
                    alert('آدرس QR کپی شد.');
                });
        }
    </script>
}
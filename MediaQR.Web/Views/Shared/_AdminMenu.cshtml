<div class="menu-user">
    <div class="menu-user-avatar">🛡️</div>

    <div class="menu-user-info">
        <strong>
            @(User.Identity?.Name ?? "مدیر")
        </strong>
        <small>پنل مدیریت</small>
    </div>
</div>

<a asp-controller="Home"
   asp-action="Index"
   class="side-menu-item">
    <span class="menu-item-icon">🏠</span>
    <span class="menu-item-text">صفحه اصلی</span>
    <span class="menu-arrow">←</span>
</a>

<a asp-controller="AnalyticsDashboard"
   asp-action="Index"
   class="side-menu-item">
    <span class="menu-item-icon">📈</span>
    <span class="menu-item-text">گزارش‌های آماری</span>
    <span class="menu-arrow">←</span>
</a>

<div class="menu-separator"></div>

<a asp-controller="MediaManagement"
   asp-action="Index"
   class="side-menu-item">
    <span class="menu-item-icon">🎵</span>
    <span class="menu-item-text">مدیریت رسانه‌ها</span>
    <span class="menu-arrow">←</span>
</a>

<a asp-controller="MediaManagement"
   asp-action="Create"
   class="side-menu-item">
    <span class="menu-item-icon">➕</span>
    <span class="menu-item-text">ایجاد رسانه</span>
    <span class="menu-arrow">←</span>
</a>

<a asp-controller="QrManagement"
   asp-action="Index"
   class="side-menu-item">
    <span class="menu-item-icon">🔳</span>
    <span class="menu-item-text">مدیریت QR Codeها</span>
    <span class="menu-arrow">←</span>
</a>

<a asp-controller="UserManagement"
   asp-action="Index"
   class="side-menu-item">
    <span class="menu-item-icon">👥</span>
    <span class="menu-item-text">مدیریت کاربران</span>
    <span class="menu-arrow">←</span>
</a>

<div class="menu-separator"></div>

<a asp-controller="Account"
   asp-action="ChangePassword"
   class="side-menu-item">
    <span class="menu-item-icon">🔑</span>
    <span class="menu-item-text">تغییر رمز عبور</span>
    <span class="menu-arrow">←</span>
</a>

<form asp-controller="Account"
      asp-action="Logout"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="side-menu-item logout-item">
        <span class="menu-item-icon">🚪</span>
        <span class="menu-item-text">خروج از حساب</span>
        <span class="menu-arrow">←</span>
    </button>
</form>
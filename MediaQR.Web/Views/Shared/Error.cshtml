@model MediaQR.Web.Models.ErrorViewModel

@{
    ViewData["Title"] = "خطا";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <div class="display-4 text-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>

                    <h1 class="h3 mb-3">
                        خطایی رخ داد
                    </h1>

                    <p class="text-muted mb-4">
                        متأسفانه هنگام پردازش درخواست شما خطایی رخ داده است.
                        لطفاً دوباره تلاش کنید.
                    </p>

                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-light text-start" dir="ltr">
                            <strong>Request ID:</strong>
                            <code>@Model.RequestId</code>
                        </div>
                    }

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-primary">
                        بازگشت به داشبورد
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>
@model MediaQR.Web.Models.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="change-password-page" dir="rtl">

    <!-- Background Decorations -->
    <div class="change-password-bg change-password-bg-1"></div>
    <div class="change-password-bg change-password-bg-2"></div>
    <div class="change-password-bg change-password-bg-3"></div>

    <div class="change-password-wrapper">

        <!-- Header -->
        <div class="change-password-header">

            <div class="change-password-header-main">

                <div class="change-password-header-icon">
                    <span>🔐</span>
                </div>

                <div>
                    <div class="change-password-badge">
                        <span class="badge-dot"></span>
                        امنیت حساب
                    </div>

                    <h1 class="change-password-title">
                        تغییر رمز عبور
                    </h1>

                    <p class="change-password-subtitle">
                        رمز عبور حساب خود را به‌روزرسانی کنید
                    </p>
                </div>

            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="change-password-back">
                <span>→</span>
                بازگشت
            </a>

        </div>


        <!-- Main Card -->
        <div class="change-password-card">

            <div class="change-password-card-header">

                <div class="card-header-icon">
                    🛡️
                </div>

                <div>
                    <h2>
                        امنیت حساب کاربری
                    </h2>

                    <p>
                        برای حفظ امنیت حساب، رمز عبور خود را تغییر دهید.
                    </p>
                </div>

            </div>


            <div class="change-password-card-body">

                @if (TempData["Success"] is string successMessage)
                {
                    <div class="change-password-success">
                        <div class="success-icon">
                            ✓
                        </div>

                        <div>
                            <strong>
                                عملیات موفق بود
                            </strong>

                            <span>
                                @successMessage
                            </span>
                        </div>
                    </div>
                }


                <div asp-validation-summary="ModelOnly"
                     class="change-password-validation">
                </div>


                <form asp-action="ChangePassword"
                      method="post"
                      id="changePasswordForm"
                      class="change-password-form">

                    @Html.AntiForgeryToken()


                    <!-- Current Password -->
                    <div class="password-form-group">

                        <label asp-for="CurrentPassword"
                               class="password-form-label">

                            <span class="label-icon">
                                🔑
                            </span>

                            رمز عبور فعلی
                        </label>

                        <div class="password-input-wrapper">

                            <span class="password-input-icon">
                                🔒
                            </span>

                            <input asp-for="CurrentPassword"
                                   id="currentPassword"
                                   type="password"
                                   class="password-form-input"
                                   autocomplete="current-password"
                                   placeholder="رمز عبور فعلی خود را وارد کنید" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="currentPassword"
                                    aria-label="نمایش رمز عبور">

                                <span class="show-icon">
                                    👁
                                </span>

                                <span class="hide-icon">
                                    ◉
                                </span>

                            </button>

                        </div>

                        <span asp-validation-for="CurrentPassword"
                              class="password-field-error">
                        </span>

                    </div>


                    <!-- New Password -->
                    <div class="password-form-group">

                        <label asp-for="NewPassword"
                               class="password-form-label">

                            <span class="label-icon">
                                ✨
                            </span>

                            رمز عبور جدید
                        </label>

                        <div class="password-input-wrapper">

                            <span class="password-input-icon">
                                🛡️
                            </span>

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   type="password"
                                   class="password-form-input"
                                   autocomplete="new-password"
                                   placeholder="رمز عبور جدید را وارد کنید" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="newPassword"
                                    aria-label="نمایش رمز عبور">

                                <span class="show-icon">
                                    👁
                                </span>

                                <span class="hide-icon">
                                    ◉
                                </span>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="password-field-error">
                        </span>

                        <div class="password-hint">
                            <span>💡</span>
                            برای امنیت بیشتر از یک رمز عبور قوی و غیرقابل حدس استفاده کنید.
                        </div>

                    </div>


                    <!-- Confirm Password -->
                    <div class="password-form-group">

                        <label asp-for="ConfirmPassword"
                               class="password-form-label">

                            <span class="label-icon">
                                ✓
                            </span>

                            تکرار رمز عبور جدید
                        </label>

                        <div class="password-input-wrapper">

                            <span class="password-input-icon">
                                🔐
                            </span>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   type="password"
                                   class="password-form-input"
                                   autocomplete="new-password"
                                   placeholder="رمز عبور جدید را دوباره وارد کنید" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="confirmPassword"
                                    aria-label="نمایش رمز عبور">

                                <span class="show-icon">
                                    👁
                                </span>

                                <span class="hide-icon">
                                    ◉
                                </span>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="password-field-error">
                        </span>

                    </div>


                    <!-- Security Notice -->
                    <div class="security-notice">

                        <div class="security-notice-icon">
                            🛡️
                        </div>

                        <div class="security-notice-content">

                            <strong>
                                نکته امنیتی
                            </strong>

                            <p>
                                پس از تغییر رمز عبور، ممکن است لازم باشد
                                مجدداً وارد حساب کاربری خود شوید.
                            </p>

                        </div>

                    </div>


                    <!-- Actions -->
                    <div class="password-actions">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="password-cancel">

                            <span>
                                ←
                            </span>

                            انصراف
                        </a>

                        <button type="submit"
                                class="password-submit"
                                id="submitPasswordButton">

                            <span class="submit-icon">
                                🔐
                            </span>

                            <span class="submit-text">
                                تغییر رمز عبور
                            </span>

                            <span class="submit-spinner"></span>

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- Footer -->
        <div class="change-password-footer">

            <div class="footer-item">
                <span class="footer-icon">🔒</span>
                اطلاعات شما محفوظ است
            </div>

            <span class="footer-dot">•</span>

            <div class="footer-item">
                <span class="footer-icon">🛡️</span>
                اتصال امن
            </div>

            <span class="footer-dot">•</span>

            <div class="footer-item">
                <span class="footer-heart">♥</span>
                MediaQR
            </div>

        </div>

    </div>

</div>


<style>

    /* =========================================
           Change Password Page
           ========================================= */

    .change-password-page {
        position: relative;
        min-height: calc(100vh - 80px);
        padding: 55px 20px 45px;
        overflow: hidden;
        background: radial-gradient( circle at 10% 15%, rgba(255, 190, 220, 0.28), transparent 32% ), radial-gradient( circle at 90% 80%, rgba(190, 190, 255, 0.25), transparent 34% ), linear-gradient( 135deg, #fff8fc 0%, #f8f6ff 48%, #f3f8ff 100% );
    }

    /* Background shapes */

    .change-password-bg {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(2px);
        opacity: 0.55;
    }

    .change-password-bg-1 {
        width: 360px;
        height: 360px;
        top: -170px;
        right: -120px;
        background: rgba(244, 170, 207, 0.22);
    }

    .change-password-bg-2 {
        width: 300px;
        height: 300px;
        bottom: -140px;
        left: -100px;
        background: rgba(175, 183, 255, 0.22);
    }

    .change-password-bg-3 {
        width: 180px;
        height: 180px;
        top: 42%;
        left: 8%;
        background: rgba(208, 186, 255, 0.12);
    }


    /* Wrapper */

    .change-password-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
    }


    /* Header */

    .change-password-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 28px;
    }

    .change-password-header-main {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .change-password-header-icon {
        width: 64px;
        height: 64px;
        flex: 0 0 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: linear-gradient( 135deg, rgba(255, 211, 232, 0.9), rgba(218, 208, 255, 0.9) );
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 12px 30px rgba(180, 130, 180, 0.15);
        font-size: 28px;
    }

    .change-password-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 5px;
        color: #a05b83;
        font-size: 12px;
        font-weight: 700;
    }

    .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d98bb0;
        box-shadow: 0 0 0 4px rgba(217, 139, 176, 0.12);
    }

    .change-password-title {
        margin: 0;
        color: #33283a;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.4;
    }

    .change-password-subtitle {
        margin: 3px 0 0;
        color: #8d8493;
        font-size: 13px;
    }

    .change-password-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 16px;
        color: #6d6372;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 13px;
        box-shadow: 0 7px 20px rgba(80, 60, 100, 0.06);
        font-size: 13px;
        font-weight: 700;
        transition: all 0.25s ease;
    }

        .change-password-back span {
            font-size: 18px;
            transition: transform 0.25s ease;
        }

        .change-password-back:hover {
            color: #a14d7b;
            background: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(80, 60, 100, 0.1);
        }

            .change-password-back:hover span {
                transform: translateX(4px);
            }


    /* Main Card */

    .change-password-card {
        overflow: hidden;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 28px;
        box-shadow: 0 25px 70px rgba(105, 75, 110, 0.11), 0 5px 18px rgba(105, 75, 110, 0.05);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
    }


    /* Card Header */

    .change-password-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 25px 30px;
        background: linear-gradient( 135deg, rgba(255, 224, 239, 0.55), rgba(229, 224, 255, 0.48) );
        border-bottom: 1px solid rgba(255, 255, 255, 0.75);
    }

    .card-header-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 7px 18px rgba(100, 75, 120, 0.08);
        font-size: 22px;
    }

    .change-password-card-header h2 {
        margin: 0 0 3px;
        color: #403444;
        font-size: 17px;
        font-weight: 800;
    }

    .change-password-card-header p {
        margin: 0;
        color: #8c8290;
        font-size: 12px;
    }


    /* Body */

    .change-password-card-body {
        padding: 30px;
    }


    /* Success */

    .change-password-success {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px 16px;
        margin-bottom: 24px;
        border: 1px solid rgba(116, 190, 151, 0.25);
        border-radius: 16px;
        background: rgba(221, 249, 233, 0.65);
        color: #367754;
    }

    .success-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.72);
        font-weight: 900;
        font-size: 17px;
    }

    .change-password-success strong,
    .change-password-success span {
        display: block;
    }

    .change-password-success strong {
        margin-bottom: 2px;
        font-size: 13px;
    }

    .change-password-success span {
        font-size: 12px;
    }


    /* Validation */

    .change-password-validation {
        margin-bottom: 22px;
        padding: 0;
        color: #c75570;
        font-size: 12px;
    }

        .change-password-validation:empty {
            display: none;
        }


    /* Form */

    .password-form-group {
        margin-bottom: 22px;
    }

    .password-form-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 9px;
        color: #4b3f4e;
        font-size: 13px;
        font-weight: 750;
    }

    .label-icon {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(248, 225, 239, 0.75);
        font-size: 12px;
    }


    /* Input */

    .password-input-wrapper {
        position: relative;
    }

    .password-input-icon {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        width: 23px;
        height: 23px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.65;
        font-size: 13px;
        pointer-events: none;
    }

    .password-form-input {
        width: 100%;
        height: 52px;
        padding: 0 48px 0 48px;
        border: 1px solid rgba(210, 201, 216, 0.65);
        border-radius: 15px;
        outline: none;
        background: rgba(255, 255, 255, 0.72);
        color: #413744;
        font-size: 13px;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
        transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

        .password-form-input::placeholder {
            color: #b2aab6;
        }

        .password-form-input:hover {
            background: rgba(255, 255, 255, 0.9);
        }

        .password-form-input:focus {
            background: #ffffff;
            border-color: #d79abc;
            box-shadow: 0 0 0 4px rgba(215, 154, 188, 0.12), 0 8px 25px rgba(120, 80, 110, 0.06);
        }


    /* Password Toggle */

    .password-toggle {
        position: absolute;
        top: 50%;
        left: 12px;
        width: 32px;
        height: 32px;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 10px;
        background: transparent;
        color: #9d91a1;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .password-toggle:hover {
            color: #a65482;
            background: rgba(246, 221, 237, 0.65);
        }

        .password-toggle .hide-icon {
            display: none;
        }

        .password-toggle.active .show-icon {
            display: none;
        }

        .password-toggle.active .hide-icon {
            display: inline;
        }


    /* Field Errors */

    .password-field-error {
        display: block;
        margin-top: 7px;
        color: #c95773;
        font-size: 11px;
        font-weight: 600;
    }


    /* Hint */

    .password-hint {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-top: 8px;
        color: #9a909d;
        font-size: 11px;
        line-height: 1.8;
    }

        .password-hint span {
            flex: 0 0 auto;
        }


    /* Security Notice */

    .security-notice {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 28px;
        margin-bottom: 28px;
        padding: 16px;
        border: 1px solid rgba(205, 190, 244, 0.38);
        border-radius: 17px;
        background: linear-gradient( 135deg, rgba(244, 239, 255, 0.76), rgba(255, 240, 248, 0.62) );
    }

    .security-notice-icon {
        width: 39px;
        height: 39px;
        flex: 0 0 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.75);
        font-size: 17px;
        box-shadow: 0 5px 15px rgba(100, 80, 130, 0.06);
    }

    .security-notice-content strong {
        display: block;
        margin-bottom: 3px;
        color: #56465e;
        font-size: 12px;
        font-weight: 800;
    }

    .security-notice-content p {
        margin: 0;
        color: #8d8292;
        font-size: 11px;
        line-height: 1.8;
    }


    /* Actions */

    .password-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding-top: 5px;
    }

    .password-cancel,
    .password-submit {
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 20px;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

    .password-cancel {
        border: 1px solid rgba(210, 201, 216, 0.65);
        background: rgba(255, 255, 255, 0.62);
        color: #756b79;
    }

        .password-cancel:hover {
            color: #514651;
            background: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(80, 60, 100, 0.08);
        }

        .password-cancel span {
            font-size: 17px;
        }

    .password-submit {
        min-width: 175px;
        border: 0;
        color: #ffffff;
        background: linear-gradient( 135deg, #d78daf 0%, #a989c8 100% );
        box-shadow: 0 10px 24px rgba(175, 110, 155, 0.22);
    }

        .password-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(175, 110, 155, 0.3);
        }

        .password-submit:active {
            transform: translateY(0);
        }

    .submit-icon {
        font-size: 15px;
    }

    .submit-spinner {
        display: none;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: changePasswordSpin 0.7s linear infinite;
    }

    .password-submit.loading .submit-icon,
    .password-submit.loading .submit-text {
        display: none;
    }

    .password-submit.loading .submit-spinner {
        display: block;
    }

    .password-submit.loading {
        pointer-events: none;
        opacity: 0.8;
    }


    /* Footer */

    .change-password-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 22px;
        color: #a49aa8;
        font-size: 10px;
    }

    .footer-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .footer-icon {
        font-size: 11px;
    }

    .footer-dot {
        color: #d1c8d3;
    }

    .footer-heart {
        color: #d58bad;
        font-size: 13px;
    }


    /* Animation */

    @@keyframes changePasswordSpin {
        to {
            transform: rotate(360deg);
        }
    }


    /* Responsive */

    @@media (max-width: 700px) {

        .change-password-page {
            padding: 35px 15px 30px;
        }

        .change-password-header {
            align-items: flex-start;
        }

        .change-password-header-icon {
            width: 55px;
            height: 55px;
            flex-basis: 55px;
            border-radius: 17px;
            font-size: 24px;
        }

        .change-password-title {
            font-size: 22px;
        }

        .change-password-subtitle {
            font-size: 12px;
        }

        .change-password-back {
            padding: 9px 12px;
        }

        .change-password-card {
            border-radius: 22px;
        }

        .change-password-card-header {
            padding: 20px;
        }

        .change-password-card-body {
            padding: 22px 20px;
        }

        .password-actions {
            flex-direction: column-reverse;
        }

        .password-cancel,
        .password-submit {
            width: 100%;
        }
    }


    @@media (max-width: 480px) {

        .change-password-header {
            flex-direction: column;
            gap: 15px;
        }

        .change-password-header-main {
            width: 100%;
        }

        .change-password-back {
            align-self: flex-start;
        }

        .change-password-card-header {
            align-items: flex-start;
        }

            .change-password-card-header p {
                line-height: 1.8;
            }

        .change-password-footer {
            gap: 7px;
        }

        .footer-dot {
            display: none;
        }
    }

</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /*
             * Password visibility
             */
            document.querySelectorAll(".password-toggle")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const targetId = button.dataset.target;
                        const input = document.getElementById(targetId);

                        if (!input) {
                            return;
                        }

                        const isPassword =
                            input.type === "password";

                        input.type =
                            isPassword ? "text" : "password";

                        button.classList.toggle(
                            "active",
                            isPassword
                        );

                    });

                });


            /*
             * Submit loading state
             */
            const form =
                document.getElementById("changePasswordForm");

            const submitButton =
                document.getElementById("submitPasswordButton");

            if (form && submitButton) {

                form.addEventListener("submit", function (event) {

                    /*
                     * Let jQuery validation stop invalid forms.
                     * Only show loading when the form is valid.
                     */
                    if (
                        typeof window.jQuery !== "undefined" &&
                        typeof window.jQuery.fn.valid === "function"
                    ) {

                        if (!window.jQuery(form).valid()) {
                            return;
                        }

                    }

                    submitButton.classList.add("loading");

                });

            }

        });

    </script>
}